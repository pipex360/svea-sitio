---
/**
 * /gracias/ — destino del redirect de TODOS los formularios (lista roja R9).
 * Lleva la conversión de respaldo del anexo F: se dispara al cargar, y es la
 * red que hoy salva los envíos de la home y de la landing de plan de emergencia.
 * Arreglo 6: nace noindex.
 */
import Base from '../../layouts/Base.astro';
import paginas from '../../data/paginas.json';

const pagina = paginas.find((p) => p.ruta === '/gracias/')!;
---
<Base pagina={pagina}>
  <article class="gracias">
    <h1>¡Gracias por contactarnos!</h1>
    <p class="entrada">
      Recibimos tu solicitud. Un especialista de SVEA Consultores te responde con la
      cotización en menos de 24 horas hábiles.
    </p>
    <p>
      ¿Es urgente? Escríbenos directo por
      <a href="https://api.whatsapp.com/send?phone=56929947924&text=Hola,%20acabo%20de%20enviar%20una%20solicitud%20de%20cotizaci%C3%B3n">WhatsApp</a>
      o llámanos al <a href="tel:+56929947924">+56 9 2994 7924</a>.
    </p>
    <p><a href="/blog/">Mientras tanto, revisa nuestras guías de cumplimiento normativo →</a></p>
  </article>

  <Fragment slot="medicion">
    <!-- Anexo F · LISTA ROJA. Conversión de respaldo al cargar /gracias/. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', 'G-FWQ05WDLZ3');
      gtag('config', 'AW-16836158536');
      gtag('event', 'conversion', {
        'send_to': 'AW-16836158536/086iCJjJlsobEMjIjdw-',
        'value': 1.0,
        'currency': 'CLP'
      });
    </script>
  </Fragment>
</Base>

<style>
  .gracias { max-width: 62ch; }
  .entrada { font-size: 1.1em; }
</style>
