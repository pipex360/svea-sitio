---
/**
 * Informe Sanitario Favorable, rehecha con el mismo formato que
 * calificacion-tecnica-industrial.astro y estudio-de-carga-de-combustible
 * .astro (ver ahí la explicación de los bloques). Texto, enlaces y
 * formulario idénticos al WordPress; los compara scripts/verificar.mjs.
 *
 * Aquí el original trae, antes de su contenedor «is-page», una franja de
 * Elementor con la foto de los camiones (sección 50365904): su frase va en
 * la descripción del formulario, y su foto es la del hero. El bloque
 * «Marco normativo aplicable», que las otras páginas no tienen, va dentro
 * de IsServicio con las mismas tarjetas.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { precargaFoto } from '../lib/fotos';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { IsFormulario } from '../components/ui/is-formulario';
import { IsQueEs } from '../components/ui/is-que-es';
import { IsServicio } from '../components/ui/is-servicio';
import { IsPasos } from '../components/ui/is-pasos';
import { IsSiguiente } from '../components/ui/is-siguiente';
import { IsFaq, PREGUNTAS } from '../components/ui/is-faq';
import SeoHead from '../components/SeoHead.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/informe-sanitario/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" {...precargaFoto('planta-alimentos-informe-sanitario', BASE)} />
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo
    fotos={[
      'planta-alimentos-informe-sanitario',
      'linea-seleccion-tomates-informe-sanitario',
      'tecnicos-casco-revision-calificacion-tecnica-industrial',
    ]}
    copete="Servicios SVEA"
    titulo="Informe Sanitario Favorable ante SEREMI de Salud"
    parrafo="Gestionamos tu informe sanitario favorable ante la SEREMI de Salud, asegurando el cumplimiento normativo de tu establecimiento. Desde la evaluación hasta la obtención de la resolución, tu empresa opera de forma segura y legal."
    boton={{ texto: 'Cotiza tu Informe Sanitario', href: '#formulario-is' }}
    principal={{ valor: '100', texto: 'trámites revisados', contador: 'pct' }}
    secundarias={[
      { destacado: 'Evaluación completa', texto: 'Infraestructura + procesos' },
      { destacado: 'Cotización en 24 hrs', texto: 'Automática por email' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-is" client:idle />

  <div class="svea-nuevo">
    <IsQueEs base={BASE} client:idle />
    <IsServicio client:idle />
    <IsPasos base={BASE} client:idle />
    <IsSiguiente base={BASE} client:idle />
    <IsFaq />
    <Cta69 destino="#formulario-is" client:idle />
    <IsFormulario copia={COPIA} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-is" client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
