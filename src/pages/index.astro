---
/**
 * Home. Primera página construida de verdad con Astro.
 *
 * El SEO sale de src/data/paginas.json, que se genera desde el CSV de Rank
 * Math: título, meta, canonical, robots y datos estructurados no se escriben
 * a mano. El hero es un componente propio y el menú una isla de React.
 *
 * Las ocho secciones y el pie son componentes propios: del WordPress ya no
 * queda nada en esta página —ni su hoja de estilos, ni sus 27 scripts, ni
 * los restos de estructura—. Las fuentes (Inter y Manrope variables,
 * subconjunto latino) y las fotos del hero se sirven desde el sitio.
 *
 * El generador sigue produciendo src/contenido/home-wp-*.html con las marcas
 * de sección: es el registro de qué se reemplazó y por dónde, y lo usan las
 * comprobaciones. Esta página ya no lo lee.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import SeoHead from '../components/SeoHead.astro';
import HeroHalo from '../components/HeroHalo.astro';
import FranjaClientes from '../components/FranjaClientes.astro';
import { precargaFoto } from '../lib/fotos';
import { FeaturesSectionWithHoverEffects } from '../components/ui/feature-section-with-hover-effects';
import { CumplimientoBento } from '../components/ui/bento-cumplimiento';
import { Cta69 } from '../components/ui/cta69';
import { Proceso } from '../components/ui/proceso';
import { Comparison02 } from '../components/ui/comparison-02';
import { Reveal } from '../components/ui/reveal';
import { Contacto } from '../components/ui/contacto';
import { Footer2 } from '../components/ui/footer2';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import paginas from '../data/paginas.json';


const pagina = paginas.find((p) => p.ruta === '/')!;
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');

// el cuerpo del WordPress se parte en las secciones ya migradas: el
// carrusel de logos y, más abajo, «Nuestros Servicios»

// Mientras esto sea la copia de trabajo, el formulario no envía (igual que
// hace el generador con los del WordPress). El día del cambio se construye
// con SVEA_PRODUCCION=1, junto con el resto de guardas del generador.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

// Las fuentes se declaran aquí y no en tailwind.css para que la ruta lleve
// la base del sitio (en GitHub Pages es /svea-sitio): Vite no reescribe los
// url() absolutos de public/ dentro del CSS.
const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD}
`;

---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- SEO desde src/data/paginas.json (Rank Math): en la copia, noindex -->
  <SeoHead pagina={pagina} copia={COPIA} />
  <MedicionSitio copia={COPIA} />

  <!-- fuentes propias: dos archivos variables, subconjunto latino, precargados -->
  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la primera foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" {...precargaFoto('planta-energia-consultoria-ambiental-cumplimiento-normativo', BASE)} />
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo />
  <BarraPegajosa base={BASE} client:idle />

  <!-- Clientes: carrusel con desenfoque en los bordes; el fondo va de blanco
       a la hoja gris de Servicios (FranjaClientes) -->
  <FranjaClientes base={BASE} degradado />

  <!-- Servicios: rejilla con realce al pasar el cursor -->
  <section class="svea-nuevo bg-hoja px-4 py-20" id="servicios" aria-labelledby="titulo-servicios">
    <Reveal className="mx-auto mb-12 max-w-7xl px-4 text-center" client:idle>
      <p class="mb-4 flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-black/60 md:text-[13px]">
        <span aria-hidden="true" class="h-px w-8 bg-border"></span>
        Tramitamos, no sólo asesoramos
        <span aria-hidden="true" class="h-px w-8 bg-border"></span>
      </p>
      <h2 id="titulo-servicios" class="mb-4 text-3xl font-medium tracking-tight text-black md:text-5xl">
        Nuestros <span class="font-black text-svea">Servicios</span>
      </h2>
      <p class="mx-auto max-w-2xl text-base leading-relaxed text-black/75 md:text-lg">
        Acompañamos a tu empresa desde el diagnóstico hasta la obtención de permisos,
        con respaldo técnico y normativo de excelencia.
      </p>
    </Reveal>
    <FeaturesSectionWithHoverEffects base={BASE} client:idle />
  </section>

  <!-- Cumplimiento: rejilla bento con las cifras y el cierre -->
  <section class="svea-nuevo bg-white px-6 py-20" id="nosotros" aria-labelledby="titulo-nosotros">
    <Reveal className="mx-auto mb-14 max-w-3xl text-center" client:idle>
      <h2 id="titulo-nosotros" class="mb-4 text-balance text-3xl font-medium tracking-tight text-black md:text-5xl">
        Cumplimiento Ambiental <span class="font-black text-svea">Sin Complicaciones.</span>
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-black/75 md:text-lg">
        Ofrecemos soluciones técnicas y normativas para garantizar la optimización en proyectos
        industriales. Experiencia, calidad y transparencia en un solo lugar.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={`${BASE}/#form-home`} class="btn-flecha">
          <span>Solicitar Consultoría</span>
          <span class="circulo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </a>
        <a href="#servicios" class="inline-flex h-14 items-center rounded-full border border-border bg-white px-8 text-lg font-medium text-black no-underline transition-colors hover:border-black/30">
          Conocer Servicios
        </a>
      </div>
    </Reveal>
    <CumplimientoBento client:visible />
  </section>

  <!-- Cómo trabajamos: fondo negro y los cinco pasos en franjas de color con foto -->
  <div class="svea-nuevo">
    <Proceso base={BASE} client:idle />
  </div>

  <!-- Cierre de la sección: franja completa con la palabra de fondo -->
  <div class="svea-nuevo">
    <Cta69
      fundirDesde="#000000"
      badge={{ label: 'Primer paso' }}
      heading="¿Listo para comenzar su proyecto?"
      button={{ label: 'Contáctanos', href: `${BASE}/#form-home` }}
      labels={{
        marqueePhrase: 'Cumplimiento',
        note: 'Deje la complejidad normativa en nuestras manos. Nuestro equipo de expertos está listo para asesorarlo hoy mismo.',
        footnote: 'Proceso simple y transparente',
      }}
      client:idle
    />
  </div>


  <!-- Lo que nos diferencia -->
  <div class="svea-nuevo" id="diferencia">
    <Comparison02 base={BASE} client:idle />
  </div>

  <!-- Contáctanos y el formulario (lista roja: ver contacto.tsx) -->
  <div class="svea-nuevo">
    <Contacto copia={COPIA} client:load />
  </div>

  <!-- Pie de página -->
  <div class="svea-nuevo">
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
  <!-- la lista desplegable con el diseño del sitio (src/lib/selector-svea.ts) -->
  <script>import '../lib/selector-svea';</script>
  <AvisoCookies copia={COPIA} />
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
