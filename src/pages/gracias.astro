---
/**
 * /gracias/ — a donde Web3Forms devuelve a quien envió un formulario.
 *
 * En Google Ads es la página que CUENTA la conversión del formulario: el
 * GTM dispara AW-16836158536/086iCJjJlsobEMjIjdw- con la vista de esta URL.
 * Por eso aquí la medición va con `gracias`: antes de cargar el GTM empuja
 * al dataLayer el email y el teléfono que el formulario dejó en
 * sessionStorage (Enhanced Conversions). Ver MedicionSitio.astro.
 *
 * El texto es el del WordPress (originales-wp/gracias.html), bloque por
 * bloque: confirmación, «¿Qué sigue ahora?» con los tres pasos, contacto
 * directo, los servicios (desde el 25-sep los ocho, como la portada) y el
 * cierre del original («Tu solicitud está en buenas manos»), que va como
 * franja propia antes del Cta69 común de todas las páginas (lo pinta
 * PaginaSimple con el mismo texto que el resto del sitio). Va noindex
 * (paginas.json).
 */
import PaginaSimple from '../layouts/PaginaSimple.astro';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
// el mismo enlace del original
const WHATSAPP = 'https://api.whatsapp.com/send/?phone=56929947924&text=Hola%2C%20acabo%20de%20enviar%20una%20solicitud%20por%20el%20sitio%20web';

const PASOS = [
  { marca: '1', cuando: 'Ahora mismo', titulo: 'Revisamos tu solicitud', texto: 'Nuestro equipo técnico analiza los datos de tu proyecto para preparar una cotización precisa y personalizada.' },
  { marca: '2', cuando: 'Menos de 24 hrs', titulo: 'Te enviamos la cotización', texto: 'Recibirás un correo electrónico con el detalle completo del servicio, plazos estimados y costos.' },
  { marca: '', cuando: '1-2 días hábiles', titulo: 'Coordinamos el inicio', texto: 'Una vez aceptada la cotización, agendamos la visita técnica o el inicio directo del servicio.' },
];

const SERVICIOS = [
  { href: '/calificacion-tecnica-industrial/', titulo: 'Calificación Técnica Industrial', texto: 'Gestión ante SEREMI para actividades industriales (CTI)' },
  { href: '/estudio-de-carga-de-combustible/', titulo: 'Estudio de Carga de Combustible', texto: 'Cálculo de carga de fuego según OGUC y NCh 1916' },
  { href: '/planes-de-emergencia-y-evacuacion/', titulo: 'Plan de Emergencia Industrial', texto: 'Protocolos de evacuación y emergencia DS 44' },
  { href: '/planes-de-emergencia-y-evacuacion-condominios/', titulo: 'Plan de Emergencia Condominios', texto: 'Cumplimiento Ley 21.442 para comunidades' },
  { href: '/manejo-de-residuos-peligrosos/', titulo: 'Manejo de Residuos Peligrosos', texto: 'Gestión RESPEL conforme DS 148' },
  { href: '/autorizacion-de-transporte-de-residuos/', titulo: 'Transporte de Residuos', texto: 'Autorización ante SEREMI de Salud' },
  // 25-sep: los ocho servicios, como la portada
  { href: '/informe-sanitario/', titulo: 'Informe Sanitario', texto: 'Autorización sanitaria ante la SEREMI de Salud' },
  { href: '/permisos-ambientales-y-pertinencias-del-seia/', titulo: 'Permisos ambientales y SEIA', texto: 'Pertinencias y permisos ambientales ante el SEA' },
];

const CHECK = '<path d="M20 6 9 17l-5-5" />';
const RELOJ = '<circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />';
const FLECHA = '<path d="M5 12h14" /><path d="m12 5 7 7-7 7" />';
---
<PaginaSimple
  ruta="/gracias/"
  miga="Gracias"
  insignia="Solicitud recibida"
  titulo="¡Gracias por <em>contactarnos!</em>"
  bajada="Hemos recibido tu solicitud correctamente. Nuestro equipo técnico te enviará una <strong>cotización personalizada en menos de 24 horas</strong>."
  gracias
>
  <div class="ps-ancho">
    <!-- ¿Qué sigue ahora? -->
    <section aria-labelledby="gr-pasos">
      <p class="ps-eyebrow">Próximos pasos</p>
      <h2 id="gr-pasos" class="ps-titulo">¿Qué sigue ahora?</h2>
      <ol class="gr-pasos">
        {PASOS.map((p) => (
          <li class="gr-paso tarjeta-svea">
            <span class="gr-num" aria-hidden={p.marca ? undefined : 'true'}>
              {p.marca || <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={CHECK} />}
            </span>
            <p class="gr-cuando">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={RELOJ} />
              {p.cuando}
            </p>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- contacto directo -->
    <section class="gr-directo" aria-labelledby="gr-directo">
      <div>
        <h3 id="gr-directo">¿Necesitas respuesta inmediata?</h3>
        <p>Si tu proyecto es urgente o prefieres hablar directamente con un asesor, contáctanos ahora:</p>
      </div>
      <div class="gr-botones">
        <a class="btn-whatsapp" href={WHATSAPP} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492l4.634-1.215A11.95 11.95 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.115 0-4.142-.662-5.846-1.908l-.42-.294-2.748.721.734-2.682-.322-.455A9.72 9.72 0 012.25 12 9.75 9.75 0 0112 2.25 9.75 9.75 0 0121.75 12 9.75 9.75 0 0112 21.75z"/></svg>
          WhatsApp directo
        </a>
        <a class="btn-linea" href="tel:+56929947924">+56 9 2994 7924</a>
      </div>
    </section>

    <!-- los servicios -->
    <section class="gr-servicios" aria-labelledby="gr-servicios">
      <p class="ps-eyebrow">Nuestros servicios</p>
      <h2 id="gr-servicios" class="ps-titulo">Conoce todo lo que podemos hacer por ti</h2>
      <ul class="gr-rejilla">
        {SERVICIOS.map((s) => (
          <li>
            <a class="gr-tarjeta tarjeta-svea" href={`${BASE}${s.href}`}>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={FLECHA} />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- el cierre del original, antes del bloque verde común -->
    <section class="gr-confianza" aria-labelledby="gr-confianza">
      <h2 id="gr-confianza" class="ps-titulo">Tu solicitud está en buenas manos</h2>
      <p>Más de 250 empresas ya confían en SVEA Consultores para sus trámites ambientales e industriales. Cotización automática, seguimiento personalizado y acompañamiento hasta la resolución.</p>
      <a class="btn-linea chica" href={`${BASE}/`}>Volver al inicio</a>
    </section>

  </div>
</PaginaSimple>

<style is:global>
  .ps .gr-pasos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:40px 0 0;padding:0;list-style:none}
  .ps .gr-paso{border:1px solid var(--borde);border-radius:12px;background:#fff;padding:26px 24px}
  .ps .gr-num{display:grid;place-items:center;width:48px;height:48px;border-radius:14px;background:var(--verde);color:#fff;
    font-family:Manrope,Inter,sans-serif;font-size:20px;font-weight:700}
  .ps .gr-num svg{width:22px;height:22px}
  .ps .gr-cuando{display:inline-flex;align-items:center;gap:6px;margin:18px 0 10px;padding:4px 10px;border-radius:999px;background:var(--hoja);
    font-size:12.5px;font-weight:600;color:rgba(0,0,0,.65)}
  .ps .gr-cuando svg{width:13px;height:13px}
  .ps .gr-paso h3{margin:0 0 8px;font-family:Manrope,Inter,sans-serif;font-size:18px;font-weight:600;letter-spacing:-.015em;color:#000}
  .ps .gr-paso p:last-child{margin:0;font-size:15px;line-height:1.6;color:var(--suave)}

  .ps .gr-directo{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;margin-top:56px;padding:30px 32px;
    border:1px solid var(--borde);border-radius:12px;background:var(--hoja)}
  .ps .gr-directo h3{margin:0 0 6px;font-family:Manrope,Inter,sans-serif;font-size:clamp(20px,2.2vw,26px);font-weight:600;letter-spacing:-.02em;color:#000}
  .ps .gr-directo p{margin:0;max-width:52ch;font-size:16px;line-height:1.6;color:var(--suave)}
  .ps .gr-botones{display:flex;flex-wrap:wrap;gap:12px}
  .ps .gr-botones .btn-whatsapp svg{width:20px;height:20px}

  .ps .gr-servicios{margin-top:88px}
  .ps .gr-confianza{margin-top:88px;padding:40px 32px;border:1px solid var(--borde);border-radius:12px;background:var(--hoja);text-align:center}
  .ps .gr-confianza .ps-titulo{margin:0 auto}
  .ps .gr-confianza p{margin:14px auto 22px;max-width:60ch;font-size:17px;line-height:1.6;color:var(--suave)}
  .ps .gr-rejilla{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:36px 0 0;padding:0;list-style:none}
  .ps .gr-tarjeta{position:relative;display:block;height:100%;padding:22px 52px 22px 22px;border:1px solid var(--borde);border-radius:12px;background:#fff;
    color:inherit;text-decoration:none}
  .ps .gr-tarjeta h3{margin:0 0 6px;font-family:Manrope,Inter,sans-serif;font-size:17px;font-weight:600;letter-spacing:-.01em;color:#000}
  .ps .gr-tarjeta p{margin:0;font-size:14.5px;line-height:1.55;color:var(--suave)}
  .ps .gr-tarjeta svg{position:absolute;right:20px;top:24px;width:18px;height:18px;color:var(--verde);transition:transform .2s}
  .ps .gr-tarjeta:hover svg{transform:translateX(3px)}
  @media (prefers-reduced-motion:reduce){.ps .gr-tarjeta svg{transition:none}}

  @media (max-width:1023px){.ps .gr-rejilla{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:820px){
    .ps .gr-pasos,.ps .gr-rejilla{grid-template-columns:minmax(0,1fr)}
    .ps .gr-directo{padding:26px 22px}
  }
</style>
