---
/**
 * Calificación Técnica Industrial, la primera página de servicio rehecha
 * entera. Del WordPress ya no queda nada: ni su hoja de estilos, ni sus
 * scripts, ni su estructura.
 *
 * El WordPress la servía en once bloques; aquí son siete, sin quitar una
 * palabra ni un enlace:
 *
 *   1. Hero (foto del servicio, cifras y el botón de cotizar)
 *   2. ¿Qué es la CTI? + ¿Quién la necesita?    ← eran dos secciones
 *   3. ¿Qué incluye? + ¿Cómo lo obtienes?       ← eran dos secciones
 *   4. Sigue por aquí: ECC + guía del blog      ← eran dos franjas sueltas
 *   5. Preguntas frecuentes
 *   6. Cierre «Regulariza tu actividad hoy»
 *   7. Formulario «Solicita tu Cotización CTI»  ← LISTA ROJA
 *
 * El formulario cierra la página, justo antes del pie y con la misma
 * tarjeta que «Contáctanos» de la portada. En el WordPress iba arriba, al
 * lado del titular; ahí competía con el hero y obligaba a decidir antes de
 * haber leído nada.
 *
 * Fuera queda sólo el carrusel de clientes, que no aportaba texto ni
 * enlaces y ya se ve en la portada.
 *
 * El SEO sale de src/data/paginas.json, que se genera desde el CSV de Rank
 * Math. Canónica: apunta a sí misma (decidido con Carlos el 24-sep; en el
 * WordPress apuntaba al artículo /calificacion-tecnica-industrial-chile/).
 *
 * `scripts/verificar.mjs` comprueba en cada corrida que ninguna palabra del
 * original se haya perdido y que los campos del formulario sigan siendo los
 * mismos.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { precargaFoto } from '../lib/fotos';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { CtiFormulario } from '../components/ui/cti-formulario';
import { CtiQueEs } from '../components/ui/cti-que-es';
import { CtiServicio } from '../components/ui/cti-servicio';
import { CtiPasos } from '../components/ui/cti-pasos';
import { CtiSiguiente } from '../components/ui/cti-siguiente';
import { CtiFaq, PREGUNTAS } from '../components/ui/cti-faq';
import SeoHead from '../components/SeoHead.astro';
import FranjaClientes from '../components/FranjaClientes.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/calificacion-tecnica-industrial/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" {...precargaFoto('instalacion-industrial-calificacion-tecnica-industrial', BASE)} />
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo
    fotos={[
      'instalacion-industrial-calificacion-tecnica-industrial',
      'taller-metalmecanico-calificacion-tecnica-industrial',
      'bodega-calificacion-tecnica-industrial',
    ]}
    copete="Servicios SVEA"
    titulo="Calificación Técnica Industrial"
    parrafo="Regulariza tu infraestructura y obtén tu patente municipal. Nos encargamos de todo el proceso ante la SEREMI de Salud, desde el informe técnico hasta la resolución aprobada."
    boton={{ texto: 'Cotiza tu CTI ahora', href: '#formulario-cti' }}
    principal={{ valor: '3-5', texto: 'días hábiles para el informe técnico' }}
    secundarias={[
      { destacado: 'Hasta la resolución', texto: 'acompañamiento ante la SEREMI' },
      { destacado: 'Cotización en 24 hrs', texto: 'automática por email' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-cti" client:idle />

  <!-- clientes: la misma franja de la portada, justo después del hero -->
  <FranjaClientes base={BASE} />

  <div class="svea-nuevo">
    <CtiQueEs base={BASE} client:idle />
    <CtiServicio client:idle />
    <CtiPasos base={BASE} client:idle />
    <CtiSiguiente base={BASE} client:idle />
    <CtiFaq />
    <CtiFormulario copia={COPIA} client:idle />
    <Cta69
      badge={{ label: 'Último paso' }}
      heading="Regulariza tu actividad hoy"
      button={{ label: 'Cotiza tu CTI ahora', href: '#formulario-cti' }}
      labels={{
        marqueePhrase: 'Calificación',
        note: 'Obtén tu Calificación Técnica Industrial con respaldo profesional. Cotización en menos de 24 horas, informe en 3-5 días hábiles.',
        footnote: 'WhatsApp directo: +56 9 2994 7924',
      }}
      client:idle
    />
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-cti" client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
