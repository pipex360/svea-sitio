---
/**
 * Estudio de Carga de Combustible, rehecha con el mismo formato que
 * calificacion-tecnica-industrial.astro (ver ahí la explicación de los siete
 * bloques). Texto, enlaces y formulario idénticos al WordPress; los compara
 * scripts/verificar.mjs.
 *
 * Canónica: apunta a sí misma (decidido con Carlos el 24-sep; en el
 * WordPress apuntaba al artículo /estudio-de-carga-combustible-chile/).
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { precargaFoto } from '../lib/fotos';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { EccFormulario } from '../components/ui/ecc-formulario';
import { EccQueEs } from '../components/ui/ecc-que-es';
import { EccServicio } from '../components/ui/ecc-servicio';
import { EccPasos } from '../components/ui/ecc-pasos';
import { EccSiguiente } from '../components/ui/ecc-siguiente';
import { EccFaq, PREGUNTAS } from '../components/ui/ecc-faq';
import SeoHead from '../components/SeoHead.astro';
import FranjaClientes from '../components/FranjaClientes.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/estudio-de-carga-de-combustible/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" {...precargaFoto('bodega-estanterias-estudio-carga-combustible', BASE)} />
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo
    fotos={[
      'bodega-estanterias-estudio-carga-combustible',
      'bodega-productos-estudio-carga-combustible',
      'bodega-racks-mercaderia-carga-combustible',
    ]}
    copete="Servicios SVEA"
    titulo="Estudio de Carga de Combustible"
    parrafo="Cuantifica el riesgo de incendio de tu instalación y cumple con la OGUC. Elaboramos el informe técnico completo para obtener tus permisos municipales y sectoriales."
    boton={{ texto: 'Cotiza tu ECC ahora', href: '#formulario-ecc' }}
    principal={{ valor: '3-5', texto: 'días hábiles para el informe técnico ECC' }}
    secundarias={[
      { destacado: 'Correcciones sin costo', texto: 'incluidas en el servicio' },
      { destacado: 'Cotización', texto: 'en menos de 24 horas' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-ecc" client:idle />

  <!-- clientes: la misma franja de la portada, justo después del hero -->
  <FranjaClientes base={BASE} />

  <div class="svea-nuevo">
    <EccQueEs base={BASE} client:idle />
    <EccServicio client:idle />
    <Cta69 destino="#formulario-ecc" badge={{ label: 'Primer paso' }} client:idle />
    <EccPasos base={BASE} client:idle />
    <EccSiguiente base={BASE} client:idle />
    <EccFaq />
    <EccFormulario copia={COPIA} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-ecc" client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
