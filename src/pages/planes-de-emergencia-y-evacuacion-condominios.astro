---
/**
 * Plan de Emergencia y Evacuación para Condominios, rehecha con el mismo
 * formato que calificacion-tecnica-industrial.astro y
 * estudio-de-carga-de-combustible.astro (ver ahí la explicación de los
 * bloques). Texto, enlaces y formulario idénticos al WordPress; los compara
 * scripts/verificar.mjs.
 *
 * El ancla del formulario era #formulario-pe en el WordPress (la misma que
 * el plan industrial); aquí es #formulario-pc para no chocar.
 */
import '../styles/tailwind.css';
import HeroHalo from '../components/HeroHalo.astro';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { PcFormulario } from '../components/ui/pc-formulario';
import { PcQueEs } from '../components/ui/pc-que-es';
import { PcServicio } from '../components/ui/pc-servicio';
import { PcSiguiente } from '../components/ui/pc-siguiente';
import { PcFaq, PREGUNTAS } from '../components/ui/pc-faq';
import SeoHead from '../components/SeoHead.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/planes-de-emergencia-y-evacuacion-condominios/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" imagesrcset={`${BASE}/img/hero/servicio-pc-1080.webp 1080w, ${BASE}/img/hero/servicio-pc-1920.webp 1920w`} imagesizes="100vw" />
</head>
<body>
  <HeroHalo
    fotos={[{ archivo: 'servicio-pc', alto: 1080 }]}
    copete="Servicios SVEA"
    titulo="Plan de Emergencia y Evacuación para Condominios"
    parrafo="Protege a tus residentes, define roles claros para Comité y Administración y asegura una evacuación eficiente. Elaboramos planes personalizados según la realidad del condominio, con foco en prevención, orden y cumplimiento normativo."
    boton={{ texto: 'Cotiza tu Plan para Condominio', href: '#formulario-pc' }}
    principal={{ valor: '7-15', texto: 'días hábiles · Plan completo entregado' }}
    secundarias={[
      { destacado: 'Enfoque 100% aplicable', texto: 'a la realidad del condominio' },
      { destacado: 'Cotización en 24 hrs', texto: 'automática por email' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-pc" client:idle />

  <div class="svea-nuevo">
    <PcQueEs base={BASE} client:idle />
    <PcServicio client:idle />
    <PcSiguiente base={BASE} client:idle />
    <PcFaq />
    <Cta69
      badge={{ label: 'Último paso' }}
      heading="Protege a tu comunidad hoy"
      button={{ label: 'Cotiza tu Plan ahora', href: '#formulario-pc' }}
      labels={{
        marqueePhrase: 'Evacuación',
        note: 'Obtén tu Plan de Emergencia y Evacuación para Condominios con respaldo profesional. Cotización en menos de 24 horas, plan completo en 7-15 días hábiles, enfoque aplicable y personalizado.',
        footnote: 'WhatsApp directo: +56 9 2994 7924',
      }}
      client:idle
    />
    <PcFormulario copia={COPIA} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <!-- en el teléfono, sitio para la barra de abajo -->
  <div class="h-20 md:hidden" aria-hidden="true"></div>
  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-pc" client:idle />

  <div class="aviso-copia">
    COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
    <a href={`${BASE}/estado/`}>ver las 27 páginas</a>
  </div>
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
