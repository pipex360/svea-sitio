---
/**
 * Manejo de Sustancias y Residuos Peligrosos, rehecha con el mismo formato
 * que calificacion-tecnica-industrial.astro y estudio-de-carga-de-combustible.astro
 * (ver en la CTI la explicación de los siete bloques). Texto, enlaces y
 * formulario idénticos al WordPress; los compara scripts/verificar.mjs.
 * En el WordPress el formulario va dentro del hero; aquí baja al bloque del
 * formulario, como en las otras dos.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { precargaFoto } from '../lib/fotos';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { RpFormulario } from '../components/ui/rp-formulario';
import { RpQueEs } from '../components/ui/rp-que-es';
import { RpServicio } from '../components/ui/rp-servicio';
import { RpSiguiente } from '../components/ui/rp-siguiente';
import { RpFaq, PREGUNTAS } from '../components/ui/rp-faq';
import SeoHead from '../components/SeoHead.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/manejo-de-residuos-peligrosos/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" {...precargaFoto('tambores-residuos-peligrosos-bodega', BASE)} />
</head>
<body>
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo
    fotos={['tambores-residuos-peligrosos-bodega']}
    copete="Servicios SVEA"
    titulo="Manejo de Sustancias y Residuos Peligrosos"
    parrafo="Gestión integral conforme a los Decretos 43/2015 y 148/2003 del MINSAL. Desde el almacenamiento seguro hasta el transporte y disposición final, aseguramos el cumplimiento normativo en cada etapa, protegiendo el medio ambiente y la salud pública."
    boton={{ texto: 'Cotiza tu Informe de Residuos', href: '#formulario-rp' }}
    principal={{ valor: 'D.S. 43 y D.S. 148', texto: 'Cumplimiento MINSAL' }}
    secundarias={[
      { destacado: 'Informe técnico completo', texto: 'personalizado a tu operación' },
      { destacado: 'Cotización en 24 hrs', texto: 'automática por email' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-rp" client:idle />

  <div class="svea-nuevo">
    <RpQueEs base={BASE} client:idle />
    <RpServicio client:idle />
    <RpSiguiente base={BASE} client:idle />
    <RpFaq />
    <Cta69
      badge={{ label: 'Último paso' }}
      heading="Asegura el cumplimiento normativo de tu empresa"
      button={{ label: 'Cotiza tu Informe ahora', href: '#formulario-rp' }}
      labels={{
        marqueePhrase: 'Residuos',
        note: 'Obtén tu Informe de Manejo de Residuos Peligrosos con respaldo profesional. Cotización en menos de 24 horas, informe técnico personalizado, cumplimiento D.S. 43 y D.S. 148.',
        footnote: 'WhatsApp directo: +56 9 2994 7924',
      }}
      client:idle
    />
    <RpFormulario copia={COPIA} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <!-- en el teléfono, sitio para la barra de abajo -->
  <div class="h-20 md:hidden" aria-hidden="true"></div>
  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-rp" client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
