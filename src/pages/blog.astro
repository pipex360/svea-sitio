---
/**
 * /blog/ — «Guías Cumplimiento Normativo Chile», el índice de las guías.
 *
 * En el WordPress era una página HTML pegada en un widget de Elementor con
 * seis tarjetas. Aquí va con el mismo lenguaje de las guías (BarraLectura,
 * cabecera clara, Footer2) y con las nueve guías: las seis de siempre con su
 * texto exacto y las tres que el índice viejo no listaba (DS 44, calificación
 * inofensiva e informe sanitario), más las siete guías nuevas de sep-2026 y
 * las tres del clúster de carga de combustible (29-sep; diecinueve en
 * total). Los datos de las tarjetas salen de
 * src/contenido/articulos/guias.ts.
 *
 * Desde el 24-sep las guías van agrupadas en los cuatro TEMAS de guias.ts
 * (Permisos SEREMI · Emergencias e incendio · Residuos; hasta el 25-sep eran cuatro), cada uno con su
 * ancla, y la frase «Guías cumplimiento normativo Chile» queda una sola vez
 * (el H1). Lo que se sacó del texto del WordPress se sacó también de su copia
 * en originales-wp/servicios/blog.html, para que verificar.mjs compare lo
 * mismo. Los párrafos de presentación van debajo de las tarjetas: primero lo
 * que se vino a buscar.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import SeoHead from '../components/SeoHead.astro';
import BarraLectura from '../components/BarraLectura.astro';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import { Reveal } from '../components/ui/reveal';
import Foto from '../components/Foto.astro';
import FranjaClientes from '../components/FranjaClientes.astro';
import { TarjetaFoto } from '../components/ui/tarjeta-foto';
import { BookOpenIcon } from 'lucide-react';
import paginas from '../data/paginas.json';
import { GUIAS, TEMAS } from '../contenido/articulos/guias';

const GRUPOS = TEMAS.map((t) => ({ ...t, guias: GUIAS.filter((g) => g.tema === t.nombre) }));

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const COPIA = !import.meta.env.SVEA_PRODUCCION;
const pagina = paginas.find((p) => p.ruta === '/blog/')!;

// los mismos enlaces del cierre del WordPress
const WHATSAPP = 'https://api.whatsapp.com/send/?phone=56929947924&text=Hola%2C%20necesito%20una%20cotizaci%C3%B3n';
const COTIZAR = `${BASE}/#form-home`;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <div class="svea-nuevo blog">
    <header class="blog-cab" id="inicio">
      <BarraLectura cotizar={COTIZAR} />
      <!-- 29-sep: la portada del blog con foto, como las guías y los servicios -->
      <div class="blog-cab-foto" aria-hidden="true">
        <Foto nombre="tecnicos-casco-revision-calificacion-tecnica-industrial" alt="" tamano="hero" diferida={false} />
      </div>
      <div class="blog-cabecera">
        <nav class="blog-migas" aria-label="Migas de pan">
          <ol>
            <li><a href={`${BASE}/`}>Inicio</a></li>
            <li aria-current="page">Blog</li>
          </ol>
        </nav>
        <p class="blog-insignia">Recursos y Guías</p>
        <h1>Guías Cumplimiento <em>Normativo</em> Chile</h1>
        <p class="blog-bajada">{GUIAS.length} guías prácticas sobre regulación ambiental, sanitaria e industrial, escritas por nuestro equipo técnico especializado: qué exige cada norma, quién está obligado, plazos y costos.</p>
        <nav class="blog-temas" aria-label="Temas">
          <ul>
            {GRUPOS.map((t) => (
              <li><a href={`#${t.id}`}>{t.nombre} <span>{t.guias.length}</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <BarraPegajosa base={BASE} cotizar={COTIZAR} client:idle />

    <!-- clientes: la misma franja de la portada y los servicios -->
    <FranjaClientes base={BASE} />

    <main class="blog-cuerpo">
      <div class="blog-ancho">
        <p class="blog-eyebrow">Nuestras Guías</p>
        <h2 class="blog-titulo">Artículos <em>destacados</em> por tema</h2>
        <p class="blog-sub">Contenido especializado para ayudarte a cumplir con la normativa ambiental, sanitaria e industrial vigente en Chile.</p>

        {GRUPOS.map((t, k) => (
          <section class="blog-tema" id={t.id} aria-labelledby={`tema-${t.id}`}>
            <div class="blog-tema-cab">
              <h2 id={`tema-${t.id}`}>{t.nombre}</h2>
              <p>{t.bajada}</p>
            </div>
            <Reveal client:idle>
            <ul class="blog-rejilla">
              {t.guias.map((g, i) => (
                <li class:list={[t.guias.length % 3 === 2 && i === 0 ? 'blog-destacada' : '', 'h-full']}>
                  <TarjetaFoto
                    href={`${BASE}/${g.slug}/`}
                    base={BASE}
                    foto={g.imagen.nombre}
                    alt={g.imagen.alt}
                    icono={BookOpenIcon}
                    pildora={`${g.fecha} · ${g.lectura}`}
                    titulo={g.titulo}
                    boton="Leer guía completa"
                    arriba="pt-24"
                    className="sm:min-h-[480px]"
                  >
                    {g.bajada}
                  </TarjetaFoto>
                </li>
              ))}
            </ul>
            </Reveal>
          </section>
        ))}
      </div>

      <section class="blog-sobre" aria-label="Sobre nuestras guías">
        <Reveal className="blog-lectura" client:idle>
          <img class="blog-logo" src={`${BASE}/img/logo-svea.webp`} alt="SVEA Consultores" width="404" height="137" loading="lazy" decoding="async" />
          <p>En SVEA Consultores publicamos recursos técnicos actualizados para ayudar a empresas y condominios a cumplir con la regulación ambiental, sanitaria e industrial vigente. Nuestras guías de cumplimiento normativo cubren planes de emergencia, calificación técnica industrial, estudios de carga combustible, autorización de transporte de residuos y manejo de residuos peligrosos — todo lo que necesitas para operar de forma legal y segura en Chile.</p>
          <p>El cumplimiento normativo en Chile es una obligación que afecta a todas las empresas con operación industrial, comercial o residencial. La <a href="https://www.bcn.cl/leychile/navegar?idNorma=30667" target="_blank" rel="noopener">Ley 19.300 de Bases Generales del Medio Ambiente</a> establece el marco legal que regula las actividades con impacto ambiental. A partir de esta ley, distintos decretos supremos y normativas sectoriales exigen permisos, planes y estudios específicos según el rubro y nivel de riesgo de cada actividad.</p>
          <p>Cada guía está diseñada para explicar en lenguaje claro los requisitos técnicos, documentos necesarios, plazos de tramitación, costos involucrados y el proceso paso a paso ante las autoridades competentes como la SEREMI de Salud, Bomberos, la Superintendencia del Medio Ambiente y las municipalidades. Nuestro equipo técnico actualiza cada guía con los aranceles y procedimientos vigentes para que siempre tengas información confiable.</p>
          <p>Entre los temas que abordamos se encuentran: la elaboración de planes de emergencia y evacuación tanto para empresas industriales como para condominios residenciales; la calificación técnica industrial necesaria para obtener la patente municipal; el estudio de carga combustible que define la resistencia al fuego requerida para tu edificio o local comercial; la autorización sanitaria para el transporte de residuos peligrosos y no peligrosos; y el manejo integral de residuos peligrosos según el DS 148. Cada guía incluye preguntas frecuentes, tablas comparativas de costos y enlaces directos para solicitar cotización.</p>
          <p>Y si prefieres que lo hagamos por ti: cotización en menos de 24 horas, informe en <span class="whitespace-nowrap">3-5 días hábiles</span> (<span class="whitespace-nowrap">5-10</span> en planes de emergencia) y gestión completa ante la autoridad.</p>
        </Reveal>
      </section>

    </main>

    <!-- el cierre común de todas las páginas (Cta69, src/data/cierre.ts);
         los plazos del cierre del original quedan en el último párrafo de arriba -->
    <Cta69 destino={`${BASE}/#form-home`} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} cotizar={COTIZAR} client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; background: #fff; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}

  .blog{--verde:#0e7a3c;--hoja:#f4f6f4;--borde:#e6e8e4;--suave:rgba(0,0,0,.66);
    font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#161b22;background:#fff}
  /* la cabecera en la hoja de la portada, sin los degradados lima y celeste */
  .blog-cab{position:relative;overflow:hidden;background:linear-gradient(to bottom,#fff,var(--hoja));border-bottom:1px solid var(--borde)}
  .blog-cab-foto{position:absolute;inset:0;z-index:0}
  .blog-cab-foto img{width:100%;height:100%;object-fit:cover}
  .blog-cab-foto::after{content:"";position:absolute;inset:0;
    background:linear-gradient(90deg,rgba(255,255,255,.92) 0%,rgba(255,255,255,.85) 45%,rgba(255,255,255,.45) 75%,rgba(255,255,255,.2) 100%),
      linear-gradient(to top,rgba(244,246,244,.95) 0%,transparent 35%)}
  .blog-cab>*:not(.blog-cab-foto){position:relative;z-index:1}
  .blog-cab>.art-barra{z-index:40}
  .blog-cabecera{min-height:min(56svh,580px);display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start}
  @media (max-width:820px){
    .blog-cab-foto::after{background:linear-gradient(to bottom,rgba(255,255,255,.75),rgba(255,255,255,.9) 45%,rgba(244,246,244,.97))}
    .blog-cabecera{min-height:0}
  }
  .blog-cabecera{max-width:calc(72rem + 48px);margin:0 auto;padding:40px 24px 64px}
  .blog-migas ol{display:flex;gap:6px;font-size:14px;color:rgba(0,0,0,.55)}
  .blog-migas li{display:inline-flex;gap:6px}
  .blog-migas li+li::before{content:"›";color:rgba(0,0,0,.35)}
  .blog-migas a{color:rgba(0,0,0,.7);text-decoration:none}
  .blog-migas a:hover{color:var(--verde);text-decoration:underline}
  .blog-insignia{display:inline-block;margin:28px 0 16px;padding:6px 12px;border-radius:999px;border:1px solid rgba(14,122,60,.2);
    background:rgba(14,122,60,.06);color:var(--verde);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
  .blog-cab h1{margin:0;max-width:18ch;font-family:Manrope,Inter,sans-serif;font-weight:500;letter-spacing:-.04em;line-height:1.05;
    font-size:clamp(38px,5.4vw,68px);color:#000;text-wrap:balance}
  .blog-cab h1 em,.blog-titulo em{font-style:normal;color:var(--verde)}
  .blog-bajada{margin:22px 0 0;max-width:58ch;font-size:19px;line-height:1.6;color:var(--suave)}

  .blog-cuerpo{padding:72px 24px 0}
  .blog-ancho{max-width:72rem;margin:0 auto}
  .blog-eyebrow{margin:0 0 12px;display:flex;align-items:center;gap:12px;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(0,0,0,.6)}
  .blog-eyebrow::before{content:"";width:32px;height:1px;background:var(--borde)}
  .blog-titulo{margin:0;max-width:26ch;font-family:Manrope,Inter,sans-serif;font-weight:500;letter-spacing:-.03em;line-height:1.1;
    font-size:clamp(28px,3.6vw,46px);color:#000;text-wrap:balance}
  .blog-sub{margin:14px 0 0;max-width:60ch;font-size:17px;line-height:1.6;color:var(--suave)}

  .blog-rejilla{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:24px}
  .blog-tema{margin-top:56px;scroll-margin-top:96px}
  .blog-tema-cab{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 20px;padding-bottom:14px;border-bottom:1px solid var(--borde)}
  .blog-tema-cab h2{margin:0;font-family:Manrope,Inter,sans-serif;font-weight:600;font-size:clamp(22px,2.4vw,28px);letter-spacing:-.02em;color:#000}
  .blog-tema-cab p{margin:0;font-size:15px;line-height:1.5;color:var(--suave)}
  .blog-temas ul{display:flex;flex-wrap:wrap;gap:8px;margin:28px 0 0;padding:0;list-style:none}
  .blog-temas a{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--borde);background:#fff;
    color:#000;font-size:14px;font-weight:500;text-decoration:none;transition:border-color .2s}
  .blog-temas a:hover{border-color:var(--verde)}
  .blog-temas span{font-size:12px;font-weight:600;color:var(--verde)}
  .blog-tarjeta{display:flex;flex-direction:column;height:100%;border:1px solid var(--borde);border-radius:12px;overflow:hidden;background:#fff;
    color:inherit;text-decoration:none}
  .blog-foto{position:relative;aspect-ratio:16/9;background:var(--hoja);overflow:hidden}
  .blog-foto img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
  .blog-tarjeta:hover .blog-foto img{transform:scale(1.03)}
  .blog-cat{position:absolute;left:14px;top:14px;padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.92);font-size:11.5px;font-weight:600;color:#000}
  .blog-texto{display:flex;flex-direction:column;flex:1;padding:20px 22px 22px}
  .blog-meta{display:flex;gap:6px;margin:0 0 10px;font-size:13px;color:rgba(0,0,0,.55)}
  .blog-texto h3{margin:0 0 10px;font-family:Manrope,Inter,sans-serif;font-weight:600;font-size:19px;line-height:1.3;letter-spacing:-.015em;color:#000}
  .blog-extracto{margin:0 0 18px;font-size:15px;line-height:1.6;color:var(--suave)}
  .blog-leer{margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:#000}
  .blog-leer svg{width:16px;height:16px;transition:transform .2s}
  .blog-tarjeta:hover .blog-leer svg{transform:translateX(4px)}
  @media (prefers-reduced-motion:reduce){.blog-foto img,.blog-leer svg{transition:none}}

  .blog-sobre{margin-top:88px;margin-bottom:0;padding:72px 24px;background:var(--hoja);border-top:1px solid var(--borde);border-bottom:1px solid var(--borde);margin-left:-24px;margin-right:-24px}
  .blog-lectura{max-width:44rem;margin:0 auto;font-size:17px;line-height:1.75;color:#262b31}
  .blog-lectura p{margin:0 0 1.1em}
  .blog-lectura strong{color:#000}
  .blog-lectura a{color:var(--verde);text-decoration:underline;text-underline-offset:3px;font-weight:500}
  .blog-logo{display:block;height:40px;width:auto;margin:0 0 28px;opacity:.85}

  /* un tema con 5 guías (3+2) deja un hueco: la primera ocupa dos columnas,
     con la foto al lado, y las filas quedan llenas (2+1 / 3) */
  @media (min-width:768px){
    .blog-destacada{grid-column:span 2}
  }
  .blog-rejilla{list-style:none;padding:0}
  @media (max-width:1023px){.blog-rejilla{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:820px){
    .blog-cabecera{padding:20px 24px 44px}
    .blog-bajada{font-size:17px}
    .blog-cuerpo{padding:48px 16px 0}
    .blog-rejilla{grid-template-columns:minmax(0,1fr)}
    .blog-sobre{margin-left:-16px;margin-right:-16px;padding:48px 20px}
  }
</style>
