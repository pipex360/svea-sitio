---
/**
 * Autorización de Transporte de Residuos, rehecha con el mismo formato que
 * calificacion-tecnica-industrial.astro (ver ahí la explicación de los siete
 * bloques). Texto, enlaces y formulario idénticos al WordPress; los compara
 * scripts/verificar.mjs.
 *
 * Dos diferencias con la CTI y el ECC, porque el original es así:
 *   - «¿Qué es?» suma un tercer bloque, «¿Qué tipos de residuos cubrimos?»
 *     (copete «Cobertura integral»), debajo de «¿Quién necesita…?».
 *   - «Sigue por aquí» no tiene guía del blog: es una sola tarjeta de
 *     servicios complementarios con tres enlaces.
 *
 * La foto del hero es la cabecera del WordPress (flota de camiones); las de
 * «¿Qué es?» son las dos del contenido original.
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import HeroHalo from '../components/HeroHalo.astro';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { TrFormulario } from '../components/ui/tr-formulario';
import { TrQueEs } from '../components/ui/tr-que-es';
import { TrServicio } from '../components/ui/tr-servicio';
import { TrSiguiente } from '../components/ui/tr-siguiente';
import { TrFaq, PREGUNTAS } from '../components/ui/tr-faq';
import SeoHead from '../components/SeoHead.astro';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pagina = paginas.find((p) => p.ruta === '/autorizacion-de-transporte-de-residuos/')!;

// Mientras esto sea la copia de trabajo, el formulario no envía.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} faq={PREGUNTAS} />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
  <!-- la foto del hero es el LCP: se precarga -->
  <link rel="preload" as="image" imagesrcset={`${BASE}/img/hero/servicio-tr-1080.webp 1080w, ${BASE}/img/hero/servicio-tr-1920.webp 1920w`} imagesizes="100vw" />
</head>
<body>
  <MedicionSitio copia={COPIA} parte="body" />
  <HeroHalo
    fotos={[{ archivo: 'servicio-tr', alto: 1257 }]}
    copete="Servicios SVEA"
    titulo="Autorización de Transporte de Residuos Peligrosos y No Peligrosos"
    parrafo="Gestionamos la autorización de transporte de residuos ante la SEREMI de Salud, asegurando el cumplimiento normativo en cada etapa del proceso. Desde la clasificación hasta la obtención del permiso, tu empresa opera de forma segura y legal."
    boton={{ texto: 'Cotiza tu Autorización', href: '#formulario-tr' }}
    principal={{ valor: 'SEREMI de Salud', texto: 'Gestión integral del permiso' }}
    secundarias={[
      { destacado: 'Documentación completa', texto: 'Clasificación + plan de manejo' },
      { destacado: 'Cotización en 24 hrs', texto: 'Automática por email' },
    ]}
  />
  <BarraPegajosa base={BASE} cotizar="#formulario-tr" client:idle />

  <div class="svea-nuevo">
    <TrQueEs base={BASE} client:idle />
    <TrServicio client:idle />
    <TrSiguiente base={BASE} client:idle />
    <TrFaq />
    <Cta69
      badge={{ label: 'Último paso' }}
      heading="Obtén tu Autorización de Transporte de Residuos"
      button={{ label: 'Cotiza tu Autorización ahora', href: '#formulario-tr' }}
      labels={{
        marqueePhrase: 'Residuos',
        note: 'Gestión integral ante la SEREMI de Salud. Cotización en menos de 24 horas, documentación completa, seguimiento hasta la aprobación del permiso.',
        footnote: 'WhatsApp directo: +56 9 2994 7924',
      }}
      client:idle
    />
    <TrFormulario copia={COPIA} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <!-- en el teléfono, sitio para la barra de abajo -->
  <div class="h-20 md:hidden" aria-hidden="true"></div>
  <BarraMovil base={BASE} copia={COPIA} cotizar="#formulario-tr" client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
</body>
</html>

<style is:global>
  body { margin: 0; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}
</style>
