---
/**
 * Plantilla de las páginas sueltas: /gracias/ y /politica-de-privacidad/.
 *
 * Hasta el 24-sep eran copias del WordPress servidas desde public/ (con su
 * hoja de Elementor, sus scripts y los recursos del sitio viejo). Ahora van
 * con el lenguaje de /blog/ y de las guías: la cabecera clara con
 * BarraLectura, migas, insignia, H1 y bajada; el contenido en el slot; y
 * el final común de todas las páginas: el cierre Cta69 (el mismo texto en
 * todo el sitio, src/data/cierre.ts) y Footer2. El texto es el del
 * original (scripts/verificar.mjs lo compara palabra por palabra).
 *
 * El <head> sale de src/data/paginas.json por SeoHead: en producción,
 * /gracias/ va «noindex, follow» y la política «index, follow».
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import SeoHead from '../components/SeoHead.astro';
import BarraLectura from '../components/BarraLectura.astro';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import paginas from '../data/paginas.json';

interface Props {
  ruta: string;
  /** texto de la última miga */
  miga: string;
  insignia: string;
  /** H1 en HTML (admite <em> para el verde) */
  titulo: string;
  /** la bajada, en HTML */
  bajada?: string;
  /** en /gracias/: empuja los datos del formulario al dataLayer antes del GTM */
  gracias?: boolean;
  /** la cabecera SEO, cuando la página no está en paginas.json (la 404) */
  seo?: { title: string; description: string; robots: string; canonical: string; jsonld?: unknown[] };
}
const { ruta, miga, insignia, titulo, bajada, gracias = false, seo } = Astro.props;

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const COPIA = !import.meta.env.SVEA_PRODUCCION;
const pagina = seo ?? paginas.find((p) => p.ruta === ruta)!;
if (!pagina) throw new Error(`falta ${ruta} en paginas.json`);
const COTIZAR = `${BASE}/#form-home`;

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead pagina={pagina} copia={COPIA} />
  <MedicionSitio copia={COPIA} gracias={gracias} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
</head>
<body>
  <MedicionSitio copia={COPIA} parte="body" />
  <div class="svea-nuevo ps">
    <header class="ps-cab" id="inicio">
      <BarraLectura cotizar={COTIZAR} />
      <div class="ps-cabecera">
        <nav class="ps-migas" aria-label="Migas de pan">
          <ol>
            <li><a href={`${BASE}/`}>Inicio</a></li>
            <li aria-current="page">{miga}</li>
          </ol>
        </nav>
        <p class="ps-insignia">{insignia}</p>
        <h1 set:html={titulo} />
        {bajada && <p class="ps-bajada" set:html={bajada} />}
      </div>
    </header>

    <BarraPegajosa base={BASE} cotizar={COTIZAR} client:idle />

    <main class="ps-cuerpo">
      <slot />
    </main>

    <Cta69 destino={COTIZAR} client:idle />
    <Footer2 base={BASE} client:idle />
  </div>

  <BarraMovil base={BASE} copia={COPIA} cotizar={COTIZAR} client:idle />

  {COPIA && (
    <div class="aviso-copia">
      COPIA DE TRABAJO · sin medición y con los formularios desactivados ·
      <a href={`${BASE}/estado/`}>ver todas las páginas</a>
    </div>
  )}
  <AvisoCookies copia={COPIA} />
</body>
</html>

<style is:global>
  body { margin: 0; background: #fff; }
  .aviso-copia{
    position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#161b18;color:#fff;
    font:400 12px/1.4 system-ui,sans-serif;padding:7px 12px;text-align:center}
  .aviso-copia a{color:#9BEB6B}

  .ps{--verde:#0e7a3c;--hoja:#f4f6f4;--borde:#e6e8e4;--suave:rgba(0,0,0,.66);
    font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#161b22;background:#fff}
  /* la cabecera en la hoja de la portada, sin los degradados lima y celeste */
  .ps-cab{background:linear-gradient(to bottom,#fff,var(--hoja));border-bottom:1px solid var(--borde)}
  .ps-cabecera{max-width:calc(72rem + 48px);margin:0 auto;padding:40px 24px 64px}
  .ps-migas ol{display:flex;gap:6px;margin:0;padding:0;list-style:none;font-size:14px;color:rgba(0,0,0,.55)}
  .ps-migas li{display:inline-flex;gap:6px}
  .ps-migas li+li::before{content:"›";color:rgba(0,0,0,.35)}
  .ps-migas a{color:rgba(0,0,0,.7);text-decoration:none}
  .ps-migas a:hover{color:var(--verde);text-decoration:underline}
  .ps-insignia{display:inline-block;margin:28px 0 16px;padding:6px 12px;border-radius:999px;border:1px solid rgba(14,122,60,.2);
    background:rgba(14,122,60,.06);color:var(--verde);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
  .ps-cab h1{margin:0;max-width:18ch;font-family:Manrope,Inter,sans-serif;font-weight:500;letter-spacing:-.04em;line-height:1.05;
    font-size:clamp(38px,5.4vw,68px);color:#000;text-wrap:balance}
  .ps-cab h1 em,.ps-titulo em{font-style:normal;color:var(--verde)}
  .ps-bajada{margin:22px 0 0;max-width:58ch;font-size:19px;line-height:1.6;color:var(--suave)}
  .ps-bajada strong{color:#000;font-weight:600}

  .ps-cuerpo{padding:72px 24px 96px}
  .ps-ancho{max-width:72rem;margin:0 auto}
  .ps-eyebrow{margin:0 0 12px;display:flex;align-items:center;gap:12px;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(0,0,0,.6)}
  .ps-eyebrow::before{content:"";width:32px;height:1px;background:var(--borde)}
  .ps-titulo{margin:0;max-width:26ch;font-family:Manrope,Inter,sans-serif;font-weight:500;letter-spacing:-.03em;line-height:1.1;
    font-size:clamp(28px,3.6vw,46px);color:#000;text-wrap:balance}

  @media (max-width:820px){
    .ps-cabecera{padding:20px 24px 44px}
    .ps-bajada{font-size:17px}
    .ps-cuerpo{padding:48px 16px 72px}
  }
</style>
