  <script is:inline>
  // El índice: abierto en el HTML (así lo leen Google y quien no tenga
  // JavaScript); en el teléfono se pliega para no empujar el texto hacia abajo.
  (function () {
    var i = document.querySelector('[data-indice]');
    if (i && window.matchMedia('(max-width: 1023px)').matches) i.open = false;
    if (i) i.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a') && window.matchMedia('(max-width: 1023px)').matches) i.open = false;
    });
    // «Copiar enlace», como el botón del WordPress
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-copiar]');
      if (!b || !navigator.clipboard) return;
      navigator.clipboard.writeText(b.getAttribute('data-copiar'));
      b.classList.add('copiado');
      setTimeout(function () { b.classList.remove('copiado'); }, 2000);
    });
    // la sección que se está leyendo, marcada en el índice
    var enlaces = Array.prototype.slice.call(document.querySelectorAll('.art-indice a'));
    if (!('IntersectionObserver' in window) || !enlaces.length) return;
    var porId = {};
    enlaces.forEach(function (a) { porId[a.getAttribute('href').slice(1)] = a; });
    var obs = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (en) {
        if (!en.isIntersecting) return;
        enlaces.forEach(function (a) { a.removeAttribute('aria-current'); });
        var a = porId[en.target.id];
        if (a) a.setAttribute('aria-current', 'location');
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    Object.keys(porId).forEach(function (id) { var s = document.getElementById(id); if (s) obs.observe(s); });
  })();
  </script>
  <!-- la lista desplegable con el diseño del sitio (src/lib/selector-svea.ts) -->
  <script>import '../lib/selector-svea';</script>
  <AvisoCookies copia={COPIA} />
</body>
