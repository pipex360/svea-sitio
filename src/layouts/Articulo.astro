---
/**
 * Plantilla de las guías de «Recursos y guías».
 *
 * En el WordPress cada artículo era una página HTML entera pegada dentro de
 * un widget de Elementor, con su propia hoja de estilos, sus scripts y su
 * barra de navegación. Aquí queda una sola plantilla y un archivo de
 * datos por guía (src/contenido/articulos/<slug>.json): las nueve del
 * WordPress, extraídas de ese HTML sin quitar una palabra, un enlace, un
 * H2/H3 ni un alt, y las guías nuevas escritas para este sitio (éstas traen
 * `actualizado`, que se muestra en la cabecera como «Actualizado el …»).
 *
 * El formato es de LECTURA, no de venta:
 *
 *   1. Cabecera sobria: migas, categoría, H1, bajada, fecha, lectura y
 *      autor, y las cifras destacadas del original. Sin foto a pantalla
 *      completa: el titular es lo primero que se lee.
 *   2. Índice con anclas a cada H2 (lateral y fijo en pantalla ancha;
 *      plegable arriba en el teléfono).
 *   3. Cuerpo a ~68 caracteres por línea, con las tablas, los destacados,
 *      los pasos y las tarjetas del original, ya con la ropa de la casa.
 *   4. Preguntas frecuentes en <details> (sin JavaScript, en el HTML).
 *   5. Compartir y la caja del autor.
 *   6. Servicio relacionado —la página de servicio de la guía, con su botón
 *      de cotizar— y las tarjetas de «Servicios relacionados» del original
 *      (sin repetir el servicio destacado).
 *   7. Otras guías del mismo tema.
 *   8. El final común de todas las páginas: el formulario de cotización
 *      (LISTA ROJA, ver articulo-formulario.tsx), el cierre (Cta69) y el pie
 *      (Footer2). En el WordPress el formulario iba a mitad del texto; donde
 *      estaba queda una llamada corta que salta a él.
 *
 * El <head> sale de src/data/paginas.json por SeoHead (title, descripción,
 * canónica y JSON-LD de Rank Math, sin tocar).
 */
import '../styles/tailwind.css';
import MedicionSitio from '../components/MedicionSitio.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import SeoHead from '../components/SeoHead.astro';
import BarraLectura from '../components/BarraLectura.astro';
import { BarraPegajosa } from '../components/ui/barra-pegajosa';
import { BarraMovil } from '../components/ui/barra-movil';
import { ArticuloFormulario } from '../components/ui/articulo-formulario';
import { Cta69 } from '../components/ui/cta69';
import { Footer2 } from '../components/ui/footer2';
import { Reveal } from '../components/ui/reveal';
import { TarjetaFoto } from '../components/ui/tarjeta-foto';
import Foto from '../components/Foto.astro';
import { BookOpenIcon, BriefcaseIcon } from 'lucide-react';
import paginas from '../data/paginas.json';
import { GUIAS, guia } from '../contenido/articulos/guias';
import { fotosEnHtml, ogFoto } from '../lib/fotos';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { LogoMarquee } from '../components/ui/logo-marquee';
import { logosClientes } from '../data/clientes';

interface Props { slug: string }
const { slug } = Astro.props;

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
// Mientras esto sea la copia de trabajo, el formulario no envía y todo va noindex.
const COPIA = !import.meta.env.SVEA_PRODUCCION;

const archivos = import.meta.glob('../contenido/articulos/*.json', { eager: true, import: 'default' });
const datos = archivos[`../contenido/articulos/${slug}.json`] as any;
if (!datos) throw new Error(`Falta src/contenido/articulos/${slug}.json`);
const pagina = paginas.find((p) => p.ruta === `/${slug}/`)!;
const esta = guia(slug);
const servicio = esta.servicio;
// «Otras guías»: seis, primero las del mismo tema (25-sep: eran las quince
// en dos columnas); el enlace «Ver todas las guías» lleva al resto
const otras = [
  ...GUIAS.filter((g) => g.slug !== slug && g.tema === esta.tema),
  ...GUIAS.filter((g) => g.slug !== slug && g.tema !== esta.tema),
].slice(0, 6);
// «Servicios relacionados»: la tarjeta chica que repite el servicio destacado no se muestra
const rutaDe = (h: string) => h.replace(/^https?:\/\/[^/]+/, '').replace(/#.*$/, '');
const todasLasTarjetas = datos.relacionados.tarjetas as { titulo: string; texto: string; href: string; enlace: string }[];
const tarjetas = todasLasTarjetas.filter((t) => rutaDe(t.href) !== servicio.ruta);
// su texto (el del WordPress) pasa a la tarjeta destacada, que es el mismo servicio
const textoDestacado = todasLasTarjetas.find((t) => rutaDe(t.href) === servicio.ruta)?.texto;
// la foto de cada servicio en sus tarjetas: la primera de su hero
const FOTO_SERVICIO: Record<string, string> = {
  '/calificacion-tecnica-industrial/': 'instalacion-industrial-calificacion-tecnica-industrial',
  '/estudio-de-carga-de-combustible/': 'bodega-estanterias-estudio-carga-combustible',
  '/planes-de-emergencia-y-evacuacion/': 'brigada-simulacro-incendio-plan-de-emergencia',
  '/planes-de-emergencia-y-evacuacion-condominios/': 'edificios-providencia-plan-emergencia-condominio',
  '/manejo-de-residuos-peligrosos/': 'tambores-residuos-peligrosos-bodega',
  '/autorizacion-de-transporte-de-residuos/': 'camion-tolva-descarga-transporte-residuos-autorizado',
  '/informe-sanitario/': 'planta-alimentos-informe-sanitario',
};
const fotoDe = (h: string) => FOTO_SERVICIO[rutaDe(h)] ?? 'tecnicos-casco-revision-calificacion-tecnica-industrial';

/** Los enlaces internos del contenido van con la raíz del sitio: aquí se les pone la base.
 *  Las fotos vienen como <img data-foto="nombre"> y pasan a su <picture> (src/lib/fotos.ts). */
const conBase = (html: string) => fotosEnHtml(html.replace(/(href|src)="\/(?!\/)/g, `$1="${BASE}/`), BASE);

/** El recuadro «Cotizar» del cuerpo trae el marcador <!--logos-clientes--> donde
 *  el WordPress tenía su propia cinta de 12 logos: ahí va la de la portada,
 *  con los mismos clientes (src/data/clientes.ts) y el mismo componente. */
const cintaClientes = `<div role="group" aria-label="Empresas que confían en SVEA" style="margin-top:22px">${renderToStaticMarkup(createElement(LogoMarquee, { logos: logosClientes(BASE) }))}</div>`;
const conClientes = (html: string) => html.replace('<!--logos-clientes-->', cintaClientes);

/**
 * Orden de los títulos y accesibilidad del cuerpo, sin tocar los JSON:
 *  · Un <h4> que cuelga directo de un <h2> (tarjetas, pasos y errores del
 *    original, sin un <h3> entre medio) pasa a <h3 class="art-h4">: mismo
 *    aspecto, jerarquía correcta. Donde la sección ya tiene un <h3>, el <h4>
 *    queda como está.
 *  · Los iconos de los destacados («i», «!», «✓») son decoración: aria-hidden.
 */
function ordenar(html: string) {
  const conIconos = html.replace(/<span class="callout-icon([^"]*)"(?![^>]*aria-hidden)>/g, '<span class="callout-icon$1" aria-hidden="true">');
  let hayH3 = false;
  let convertido = false;
  return conIconos.replace(/<(\/?)h([234])\b([^>]*)>/g, (todo, cierre, n, resto) => {
    if (n === '2') { if (!cierre) hayH3 = false; return todo; }
    if (n === '3') { if (!cierre) hayH3 = true; return todo; }
    if (cierre) return convertido ? ((convertido = false), '</h3>') : todo;
    if (hayH3) return todo;
    convertido = true;
    return /class="/.test(resto) ? `<h3${resto.replace(/class="/, 'class="art-h4 ')}>` : `<h3 class="art-h4"${resto}>`;
  });
}

/**
 * Tablas en el teléfono (25-sep): con min-width 560 px dentro de 340 px
 * cortaban columnas sin aviso. Cada celda del cuerpo lleva `data-label` con
 * el encabezado de su columna; bajo 640 px la tabla se apila (cada fila es
 * una tarjeta: la primera celda como título y el resto «rótulo: valor»).
 */
function tablasApiladas(html: string) {
  return html.replace(/<table\b[\s\S]*?<\/table>/g, (tabla) => {
    const cab = tabla.match(/<thead\b[\s\S]*?<\/thead>/);
    if (!cab) return tabla;
    const rotulos = (cab[0].match(/<th\b[^>]*>[\s\S]*?<\/th>/g) || []).map((th) =>
      th.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().replace(/"/g, '&quot;'));
    return tabla.replace(/<tbody\b[\s\S]*?<\/tbody>/, (cuerpo) =>
      cuerpo.replace(/<tr\b[^>]*>[\s\S]*?<\/tr>/g, (fila) => {
        let i = 0;
        return fila.replace(/<(td|th)\b([^>]*)>/g, (_t, tag, attrs) => {
          const r = rotulos[i++] ?? '';
          return r && !/data-label=/.test(attrs) ? `<${tag}${attrs} data-label="${r}">` : `<${tag}${attrs}>`;
        });
      }));
  });
}

/** Lo mismo para un href suelto. */
const ruta = (h: string) => (h.startsWith('/') && !h.startsWith('//') ? `${BASE}${h}` : h);

const FAQ = (datos.faq.items as { p: string; r: string; rTexto: string }[]).map(({ p, rTexto }) => ({ p, r: rTexto }));

const MESES: Record<string, string> = {
  enero: '01', febrero: '02', marzo: '03', abril: '04', mayo: '05', junio: '06',
  julio: '07', agosto: '08', septiembre: '09', octubre: '10', noviembre: '11', diciembre: '12',
};
const [mes, anio] = String(datos.fecha).toLowerCase().split(' ');
const fechaISO = MESES[mes] && anio ? `${anio}-${MESES[mes]}` : undefined;
// si la guía se publicó en otro mes, se muestran las dos fechas
const publicadaAntes = datos.actualizado && fechaISO && !String(datos.actualizado.iso).startsWith(fechaISO);
// datePublished del Article: la del WordPress (Rank Math) si existe; si no, la de la guía
const articuloWP = (pagina.jsonld ?? []).flatMap((b: any) => (b && b['@graph'] ? b['@graph'] : [b])).find((n: any) => n && n['@type'] === 'Article' && n.datePublished);
const publicado = articuloWP?.datePublished ?? (fechaISO ? `${fechaISO}-01` : undefined);
const modificado = datos.actualizado?.iso ?? publicado;

const FORM = '#article-lead-form-wrapper';

const flecha = '<span class="circulo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>';

/** Icono y nombre legible de cada botón de compartir del original. */
function compartir(e: { href?: string; texto: string; titulo: string; copiar?: string }) {
  const h = e.href ?? '';
  if (e.copiar) return { nombre: e.titulo || 'Copiar enlace', icono: 'enlace' };
  if (h.includes('linkedin')) return { nombre: e.titulo || 'Compartir en LinkedIn', icono: 'linkedin' };
  if (h.includes('whatsapp')) return { nombre: e.titulo || 'Compartir por WhatsApp', icono: 'whatsapp' };
  if (h.includes('twitter')) return { nombre: e.titulo || 'Compartir en X', icono: 'x' };
  return { nombre: e.titulo || 'Enviar por email', icono: 'correo' };
}
const ICONOS: Record<string, string> = {
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  whatsapp: '<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>',
  x: '<path d="M4 4l11.7 16H20L8.3 4H4z"/><path d="M4 20l6.8-6.8M13.2 10.8L20 4"/>',
  correo: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  enlace: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
};

// «Compartir», igual en todas las guías (25-sep): LinkedIn, WhatsApp, correo
// y copiar enlace, armados con la URL pública y el título de la guía. Antes
// cada guía traía su juego del WordPress (unas sin correo, una con X).
const URL_GUIA = `https://sveaconsultores.cl/${slug}/`;
const tituloUrl = encodeURIComponent(esta.titulo);
const urlUrl = encodeURIComponent(URL_GUIA);
const COMPARTIR = [
  { href: `https://www.linkedin.com/sharing/share-offsite/?url=${urlUrl}`, titulo: 'Compartir en LinkedIn', externo: true, texto: 'in' },
  { href: `https://api.whatsapp.com/send?text=${tituloUrl}%20${urlUrl}`, titulo: 'Compartir por WhatsApp', externo: true, texto: 'wa' },
  { href: `mailto:?subject=${tituloUrl}&body=Te%20comparto%20esta%20gu%C3%ADa%3A%20${urlUrl}`, titulo: 'Enviar por email', texto: '@' },
  { copiar: URL_GUIA, titulo: 'Copiar enlace', texto: '#' },
];

const fuentesCSS = `
@font-face{font-family:'Inter';font-style:normal;font-weight:400 900;font-display:swap;src:url(${BASE}/fonts/inter-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Manrope';font-style:normal;font-weight:500 800;font-display:swap;src:url(${BASE}/fonts/manrope-variable-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SeoHead
    pagina={pagina}
    copia={COPIA}
    faq={FAQ}
    tipo="article"
    articulo={{ titulo: esta.titulo, miga: datos.migaFinal, publicado, modificado, imagen: ogFoto(esta.imagen.nombre), seccion: esta.tema }}
  />
  <MedicionSitio copia={COPIA} />

  <link rel="preload" href={`${BASE}/fonts/inter-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${BASE}/fonts/manrope-variable-latin.woff2`} as="font" type="font/woff2" crossorigin />
  <style set:html={fuentesCSS}></style>
</head>
<body class="botones-planos">
  <MedicionSitio copia={COPIA} parte="body" />
  <div class="svea-nuevo art">
    <div class="art-progreso" aria-hidden="true"></div>

    <!-- #inicio: mientras se ve, la barra pegajosa no aparece (la cabecera ya trae la suya) -->
    <header class="art-cab" id="inicio">
      <BarraLectura cotizar={FORM} />

      <!-- 29-sep: la portada de la guía lleva su foto, como el hero de los
           servicios: fija, con un velo blanco que deja leer el titular -->
      <div class="art-cab-foto" aria-hidden="true">
        <Foto nombre={esta.imagen.nombre} alt="" tamano="hero" prioridad />
      </div>

      <div class="art-cabecera">
        <nav class="art-migas" aria-label="Migas de pan">
          <ol>
            <li><a href={`${BASE}/`}>Inicio</a></li>
            <li><a href={`${BASE}/blog/`}>Guías</a></li>
            <li aria-current="page"><span>{datos.migaFinal}</span></li>
          </ol>
        </nav>
        <p class="art-categoria">{esta.tema}</p>
        <h1>{datos.h1}</h1>
        <p class="art-bajada">{datos.bajada}</p>
        <ul class="art-meta">
          {publicadaAntes && <li>Publicado:&nbsp;<time datetime={fechaISO}>{datos.fecha}</time></li>}
          {datos.actualizado ? (
            <li>Actualizado el&nbsp;<time datetime={datos.actualizado.iso}>{datos.actualizado.texto}</time></li>
          ) : (
            <li><time datetime={fechaISO}>{datos.fecha}</time></li>
          )}
          <li>{datos.lectura}</li>
          <li>Por {datos.autor}</li>
        </ul>
        {datos.cifras?.length > 0 && (
          <dl class="art-cifras">
            {datos.cifras.map((c: { n: string; l: string }) => (
              <div><dt>{c.l}</dt><dd>{c.n}</dd></div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <BarraPegajosa base={BASE} cotizar={FORM} client:idle />

    <div class="art-marco">
      <details class="art-indice" open data-indice>
        <summary>{datos.indiceTitulo}</summary>
        <nav aria-label={datos.indiceTitulo}>
          <ol>
            {datos.indice.map((e: { href: string; texto: string }) => (
              <li><a href={e.href}>{e.texto}</a></li>
            ))}
          </ol>
        </nav>
      </details>

      <article class="art-cuerpo">
        {datos.bloques.map((b: { tipo: string; html?: string }) =>
          b.tipo === 'html' ? (
            <Fragment set:html={conClientes(tablasApiladas(ordenar(conBase(b.html!))))} />
          ) : (
            <aside class="art-salto" aria-label="Cotización">
              <p><strong>{datos.formulario.titulo}.</strong> El formulario está al final de la guía.</p>
              <a class="art-boton-linea" href={FORM}>Ir al formulario</a>
            </aside>
          ),
        )}

        <section id={datos.faq.id} class="art-faq" aria-labelledby="titulo-faq">
          <h2 id="titulo-faq">{datos.faq.titulo}</h2>
          {datos.faq.items.map((f: { p: string; r: string }, i: number) => (
            <details class="acordeon" open={i === 0}>
              <summary>
                <h3>{f.p}</h3>
                <svg class="art-faq-flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="art-faq-r"><p set:html={conBase(f.r)} /></div>
            </details>
          ))}
        </section>

        <footer class="art-pie">
          {(
            <div class="art-compartir">
              <span>{datos.compartir?.titulo ?? 'Compartir'}</span>
              {COMPARTIR.map((e: any) => {
                const c = compartir(e);
                return e.copiar ? (
                  <button type="button" class="art-compartir-btn" data-copiar={e.copiar} title={c.nombre}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONOS[c.icono]} />
                    <span class="sr-only">{c.nombre}</span>
                  </button>
                ) : (
                  <a class="art-compartir-btn" href={e.href} target={e.externo ? '_blank' : undefined} rel={e.externo ? 'noopener' : undefined} title={c.nombre} aria-label={c.nombre}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONOS[c.icono]} />
                  </a>
                );
              })}
            </div>
          )}
          {datos.autorCaja && (
            <div class="art-autor">
              <span class="art-autor-logo" aria-hidden="true">S</span>
              <div>
                <p class="art-autor-nombre">{datos.autorCaja.nombre}</p>
                <p set:html={conBase(datos.autorCaja.texto)} />
              </div>
            </div>
          )}
        </footer>
      </article>
    </div>


    <section class="art-servicio" aria-labelledby="titulo-servicios">
      <div class="art-ancho">
        <h2 id="titulo-servicios">{datos.relacionados.titulo}</h2>
        {datos.relacionados.intro && <p class="art-servicio-intro" set:html={conBase(datos.relacionados.intro)} />}
        <div class:list={['art-fotos', tarjetas.length === 0 && 'sola', (tarjetas.length === 1 || tarjetas.length === 3) && 'pares']}>
          <Reveal className="h-full" client:idle>
            <TarjetaFoto
              base={BASE}
              foto={fotoDe(servicio.ruta)}
              alt=""
              icono={BriefcaseIcon}
              pildora="Servicio relacionado"
              titulo={servicio.nombre}
              verificado
              acciones={[
                { texto: 'Cotizar este servicio', href: `${BASE}${servicio.ruta}${servicio.formulario}` },
                { texto: 'Ver el servicio', href: `${BASE}${servicio.ruta}` },
              ]}
              arriba="pt-14"
            >
              {textoDestacado ? <Fragment set:html={conBase(textoDestacado)} /> : servicio.texto}
            </TarjetaFoto>
          </Reveal>
          {tarjetas.map((t, i) => (
            <Reveal className="h-full" delay={0.06 * (i + 1)} client:idle>
              <TarjetaFoto
                base={BASE}
                foto={fotoDe(t.href)}
                alt=""
                icono={BriefcaseIcon}
                pildora="Servicio"
                titulo={t.titulo}
                acciones={[{ texto: t.enlace, href: ruta(t.href) }]}
                arriba="pt-14"
              >
                <Fragment set:html={conBase(t.texto)} />
              </TarjetaFoto>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <section class="art-otras" aria-labelledby="titulo-otras">
      <div class="art-ancho">
        <div class="art-otras-cab">
          <h2 id="titulo-otras">Otras guías del blog</h2>
          <a class="art-boton-linea" href={`${BASE}/blog/`}>Ver todas las guías</a>
        </div>
        <ul class="art-fotos">
          {otras.map((g, i) => (
            <Reveal as="li" className="h-full" delay={0.05 * i} client:idle>
              <TarjetaFoto
                href={`${BASE}/${g.slug}/`}
                base={BASE}
                foto={g.imagen.nombre}
                alt=""
                icono={BookOpenIcon}
                pildora={g.tema}
                titulo={g.titulo}
                boton="Leer guía"
                arriba="pt-24"
                className="sm:min-h-[460px]"
              >
                {g.bajada}
