  <!-- revelado de lo que está bajo el pliegue; lo visible al cargar no se toca -->
  <script is:inline>
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var borde = window.innerHeight;
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.remove('lp-oculto'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-rv]').forEach(function (el) {
      if (el.getBoundingClientRect().top > borde) { el.classList.add('lp-oculto'); io.observe(el); }
    });
  })();
  // la barra del teléfono aparece cuando el formulario quedó arriba
  (function () {
    var barra = document.querySelector('.lp-barra');
    var form = document.getElementById('formulario');
    if (!barra || !form || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (es) {
      var e = es[0];
      var pasado = !e.isIntersecting && e.boundingClientRect.top < 0;
      barra.classList.toggle('visible', pasado);
      if (pasado) { barra.removeAttribute('inert'); barra.removeAttribute('aria-hidden'); }
      else { barra.setAttribute('inert', ''); barra.setAttribute('aria-hidden', 'true'); }
    }).observe(form);
  })();
  </script>

  <!-- C · asunto dinámico, la misma lógica del original: el prefijo y la
       palabra de servicio los lee n8n -->
  <script is:inline define:vars={{ prefijoAsunto: m.prefijoAsunto, formId: d.formulario.id, subjectId: m.subjectId }}>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById(formId);
    if (!form) return;
    form.addEventListener('submit', function () {
      var campoNombre  = form.querySelector('input[name="Nombre"]');
      var campoEmpresa = form.querySelector('input[name="Empresa"]') ||
                         form.querySelector('input[name="Condominio"]');
      var nombre  = ((campoNombre && campoNombre.value) || '').trim() || 'Sin nombre';
      var empresa = ((campoEmpresa && campoEmpresa.value) || '').trim();
      var ahora = new Date();
      var fecha = ahora.toLocaleDateString('es-CL') + ' ' +
                  ahora.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' });
      var asunto = prefijoAsunto + nombre + (empresa ? ' | ' + empresa : '') + ' - ' + fecha;
      var destino = document.getElementById(subjectId);
      if (destino) destino.value = asunto;
    });
  });
  </script>

  {COPIA && (
    <Fragment>
      <!-- D · gclid y utm_* en la copia (en producción lo hace MedicionSitio) -->
      <script is:inline>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var campos = ['gclid','utm_source','utm_medium','utm_campaign','utm_content','utm_term'];
        campos.forEach(function (f) {
          var val = params.get(f);
          if (val) {
            var el = document.getElementById('field-' + f);
            if (el) el.value = val;
          }
        });
        if (params.get('gclid')) {
          sessionStorage.setItem('gclid', params.get('gclid'));
        } else if (sessionStorage.getItem('gclid')) {
          var el = document.getElementById('field-gclid');
          if (el && !el.value) el.value = sessionStorage.getItem('gclid');
        }
      })();
      </script>
    </Fragment>
  )}
</body>
</html>

