  @media (prefers-reduced-motion: reduce) { [data-rv] { transition: none; } .lp-oculto { opacity: 1; transform: none; } }

  .lp-barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; gap: 10px; align-items: center;
