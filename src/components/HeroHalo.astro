---
/**
 * Hero de la home. Copia del hero de hirael.com/usd-halo con las fotos del
 * slideshow original: cabecera clara alineada con la tarjeta, veladuras
 * blancas, halo tras el mensaje, Ken Burns en las fotos y las cifras abajo.
 *
 * El menú es una isla de React (Radix), montada sólo cuando el navegador
 * está libre: el resto del hero es HTML y CSS, sin JavaScript. En el
 * teléfono la cabecera es logo + menú ☰ (MenuMovil); el botón de cotizar
 * de la cabecera repetía al grande de abajo y se esconde.
 *
 * Toma props para poder usarse también en las páginas de servicio: fotos,
 * copete, titular, párrafo, botón y cifras. Sin props rinde exactamente la
 * portada, así que index.astro no cambia.
 *
 * Con varias fotos se turnan con el fundido y el Ken Burns; con una sola
 * queda fija.
 *
 * Las fotos son las tres del slideshow original, servidas desde el sitio en
 * WebP a 1920 y 1080 px (mejoras/img/hero): 132/258/102 KB en vez de los
 * 539/925/379 KB en JPG que bajaban del WordPress. La primera se precarga
 * desde la cabecera de la página, porque es el LCP.
 */
import MenuSvea from './ui/navigation-menu-06';
import { MenuMovil } from './ui/menu-movil';

const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');

export type Foto = { archivo: string; alto: number };
export type Cifra = { destacado: string; texto: string };

interface Props {
  /** Las fotos del fondo. Con más de una se turnan con el fundido y el Ken Burns. */
  fotos?: Foto[];
  copete?: string;
  titulo?: string;
  parrafo?: string;
  boton?: { texto: string; href: string };
  /** La cifra grande, con su punto verde. `contador` la hace subir desde cero. */
  principal?: { valor: string; texto: string; contador?: 'mas' | 'pct' };
  secundarias?: Cifra[];
}

const {
  fotos = [
    { archivo: 'hero-1-energia', alto: 1280 },
    { archivo: 'hero-2-logistica', alto: 1257 },
    { archivo: 'hero-3-planta', alto: 1079 },
  ],
  copete,
  titulo = 'Consultoría Ambiental y Cumplimiento Normativo',
  parrafo = 'En SVEA llevamos el cumplimiento de tu empresa de punta a punta: diagnóstico, informes técnicos y el trámite ante la autoridad hasta que el permiso sale aprobado.',
  boton = { texto: 'Solicitar cotización', href: `${BASE}/#form-home` },
  principal = { valor: '250', texto: 'empresas atendidas', contador: 'mas' },
  secundarias = [
    { destacado: '100%', texto: 'satisfacción' },
    { destacado: '24 hrs', texto: 'cotización' },
    { destacado: 'Aprobación', texto: 'garantizada' },
  ],
} = Astro.props as Props;
---

<div class="halo svea-nuevo">
  <header class="halo-cab">
    <div class="halo-cab-caja">
      <a class="halo-marca" href={`${BASE}/`} aria-label="SVEA Consultores, inicio">
        <img src={`${BASE}/img/logo-svea.webp`} width="404" height="137" alt="SVEA Consultores" fetchpriority="high" />
      </a>

      <MenuSvea base={BASE} client:idle />

      <div class="halo-cab-acciones">
        <!-- el teléfono de la barra superior del WordPress, ahora como enlace:
             allí era texto plano y no se podía tocar para llamar -->
        <a class="halo-tel max-md:hidden" href="tel:+56929947924">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg><span>+56 9 2994 7924</span>
        </a>
        <!-- en el teléfono no cabe el número: va el icono, y el botón se
             esconde porque repetía al botón grande de abajo -->
        <a class="halo-llamar md:hidden" href="tel:+56929947924" aria-label="Llamar a SVEA Consultores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg></a>
        <a class="btn-flecha max-md:hidden" href={`${BASE}/#form-home`} style="gap:0"><span>Solicitar cotización</span></a>
        <MenuMovil base={BASE} client:idle />
      </div>
    </div>
  </header>

  <section class="halo-seccion" id="inicio" aria-label="Presentación">
    <div class="halo-tarjeta">
      <div class:list={['halo-fondo', { una: fotos.length === 1 }]} aria-hidden="true">
        {fotos.map((f, i) => (
          <img
            src={`${BASE}/img/hero/${f.archivo}-1920.webp`}
            srcset={`${BASE}/img/hero/${f.archivo}-1080.webp 1080w, ${BASE}/img/hero/${f.archivo}-1920.webp 1920w`}
            sizes="100vw"
            width="1920"
            height={f.alto}
            alt=""
            fetchpriority={i === 0 ? 'high' : undefined}
            loading={i === 0 ? undefined : 'lazy'}
          />
        ))}
      </div>
      <div class="halo-velo-arriba" aria-hidden="true"></div>
      <div class="halo-velo-abajo" aria-hidden="true"></div>
      <div class="halo-aura" aria-hidden="true"></div>

      <div class="halo-contenido">
        {copete && <p class="halo-copete">{copete}</p>}
        <h1>{titulo}</h1>
        <p>{parrafo}</p>
        <a class="btn-flecha" href={boton.href}>
          <span>{boton.texto}</span>
          <span class="circulo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
        </a>

        <div class="halo-pulso" aria-label="Cifras">
          <div class="principal">
            <span class="punto" aria-hidden="true"></span>
            {principal.contador
              ? <b class={`cifra ${principal.contador === 'mas' ? 'pre' : 'pct'}`} style={`--meta:${principal.valor}`}></b>
              : <b>{principal.valor}</b>}
            <span>{principal.texto}</span>
          </div>
          <div class="secundarias">
            {secundarias.map((c) => (
              <span><i>→</i><b>{c.destacado}</b> {c.texto}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style is:global>
  /* Los contadores suben desde cero al cargar, en CSS. */
  @property --n{syntax:"<integer>";inherits:false;initial-value:0}
  .halo .cifra{counter-reset:n var(--n);animation:sube-n 1.6s cubic-bezier(.2,.7,.2,1) forwards;font-variant-numeric:tabular-nums}
  .halo .cifra::after{content:counter(n)}
  .halo .cifra.pre::before{content:"+"}
  .halo .cifra.pct::after{content:counter(n) "%"}
  @keyframes sube-n{from{--n:0}to{--n:var(--meta)}}

  /* svh y no dvh: en el teléfono dvh cambia de valor mientras la barra del
     navegador se esconde al bajar, y el hero se reacomodaba en pleno scroll */
  .halo{position:relative;background:#fff;color:#161b22;font-family:Inter,ui-sans-serif,system-ui,sans-serif;
    display:flex;flex-direction:column;min-height:100vh;min-height:100svh}

  /* la cabecera va sobre la foto, no en una franja aparte; se alinea con el
     titular (mismo margen izquierdo que .halo-contenido) */
  .halo-cab{position:absolute;top:0;left:0;right:0;z-index:50;padding:20px 48px}
  .halo-cab-caja{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .halo-cab-acciones{display:flex;align-items:center;gap:14px}
  .halo-tel{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;
    font-size:15px;font-weight:500;color:#000;text-decoration:none;transition:color .2s}
  .halo-tel:hover{color:#0e7a3c}
  .halo-tel svg{width:17px;height:17px;color:rgba(0,0,0,.5)}
  .halo-llamar{display:grid;place-items:center;width:44px;height:44px;color:#000;text-decoration:none}
  .halo-llamar svg{width:21px;height:21px}
  .halo-marca img{height:40px;width:auto;display:block}

  .halo-seccion{flex:1;display:flex;align-items:flex-end;padding:0}
  .halo-tarjeta{position:relative;width:100%;max-width:none;margin:0;overflow:hidden;border-radius:0;
    height:100vh;height:100svh;min-height:560px}
  .halo-fondo{position:absolute;inset:0}
  .halo-fondo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;
    transform-origin:center center;will-change:opacity,transform;
    animation:halo-fundido 18s linear infinite}
  .halo-fondo img:nth-child(1){animation-delay:0s;opacity:1;animation-name:halo-fundido-primera}
  /* Con una sola foto no hay turnos: el fundido la apagaba y dejaba el hero
     en blanco diez de cada dieciocho segundos (medido en la página de la
     CTI). Queda fija. */
  .halo-fondo.una img{animation:none;opacity:1;transform:none}
  .halo-fondo img:nth-child(2){animation-delay:6s}
  .halo-fondo img:nth-child(3){animation-delay:12s}
  /* Ken Burns: la foto se acerca mientras está a la vista y recupera su
     tamaño mientras está invisible, para que el ciclo no dé un salto. */
  @keyframes halo-fundido{
    0%{opacity:0;transform:scale(1)}
    5%{opacity:1;transform:scale(1.02)}
    33%{opacity:1;transform:scale(1.12)}
    38%{opacity:0;transform:scale(1.14)}
    39%{opacity:0;transform:scale(1)}
    100%{opacity:0;transform:scale(1)}
  }
  @keyframes halo-fundido-primera{
    0%{opacity:1;transform:scale(1)}
    33%{opacity:1;transform:scale(1.12)}
    38%{opacity:0;transform:scale(1.14)}
    39%{opacity:0;transform:scale(1)}
    95%{opacity:0;transform:scale(1)}
    100%{opacity:1;transform:scale(1)}
  }
  .halo-velo-arriba{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(255,255,255,.7),rgba(255,255,255,.2) 50%,rgba(255,255,255,.1))}
  .halo-velo-abajo{position:absolute;left:0;right:0;bottom:0;height:50%;background:linear-gradient(to top,rgba(255,255,255,.85),rgba(255,255,255,.4) 50%,transparent)}
  /* el halo: resplandor blanco tras el mensaje, con deriva lenta.
     La deriva va en transform y no en background-position: mover el
     degradado obligaba a repintar la pantalla entera en cada cuadro
     (medido en el teléfono: 102 repintados completos en 2 s de scroll);
     transform lo mueve el compositor sin repintar. El elemento sobresale un
     8 % para que al moverse no asomen sus bordes. */
  .halo-aura{position:absolute;inset:-8%;pointer-events:none;will-change:transform;
    background:
      radial-gradient(58% 52% at 30% 40%,rgba(255,255,255,.92),rgba(255,255,255,.55) 45%,rgba(255,255,255,0) 72%),
      radial-gradient(42% 38% at 10% 26%,rgba(255,255,255,.55),rgba(255,255,255,0) 70%);
    animation:halo-deriva 22s ease-in-out infinite}
  @keyframes halo-deriva{0%,100%{transform:translate3d(0,0,0)}50%{transform:translate3d(3%,-2%,0)}}

  .halo-contenido{position:relative;z-index:1;display:flex;flex-direction:column;align-items:flex-start;height:100%;padding:144px 48px 48px}
  .halo-copete{margin:0 0 14px;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(0,0,0,.6)}
  .halo h1{margin:0 0 16px;max-width:22ch;font-family:Manrope,Inter,sans-serif;font-weight:500;letter-spacing:-.04em;line-height:1.1;
    font-size:clamp(36px,4.2vw,56px);color:#000;text-transform:none;text-wrap:balance}
  .halo p{margin:0 0 32px;max-width:44ch;font-size:18px;line-height:1.6;color:rgba(0,0,0,.7)}
  /* el botón negro con la flecha (.btn-flecha) vive en la hoja de estilos:
     lo usan también las secciones de más abajo */
  .halo-cab .btn-flecha{padding:0 24px;height:40px;font-size:15px;white-space:nowrap}
  /* la veladura de arriba deja la foto clara: el texto oscuro se lee igual */

  .halo-pulso{margin-top:auto;padding-top:56px;display:flex;flex-direction:column;gap:14px}
  .halo-pulso .principal{display:flex;align-items:center;gap:14px}
  .halo-pulso .punto{position:relative;width:12px;height:12px;border-radius:50%;background:#0e7a3c;flex-shrink:0}
  .halo-pulso .punto::before{content:"";position:absolute;inset:-6px;border-radius:50%;background:rgba(14,122,60,.25);animation:late 1.8s ease-out infinite}
  @keyframes late{0%{transform:scale(.6);opacity:1}100%{transform:scale(1.8);opacity:0}}
  .halo-pulso .principal b{font-family:Manrope,Inter,sans-serif;font-weight:500;font-size:48px;letter-spacing:-.03em;line-height:1;color:#000}
  .halo-pulso .principal span{font-size:18px;color:rgba(0,0,0,.6)}
  .halo-pulso .secundarias{display:flex;flex-wrap:wrap;gap:8px 28px;padding-left:26px;font-size:15px;color:rgba(0,0,0,.6)}
  .halo-pulso .secundarias b{color:#000;font-weight:600}
  .halo-pulso .secundarias i{font-style:normal;color:rgba(0,0,0,.35);margin-right:8px}

  @media (max-width:820px){
    .halo-cab{padding:14px 24px}
    .halo-cab .btn-flecha{padding:0 18px;height:44px;font-size:14px}  /* 44 px: alto mínimo para el dedo */
    .halo-marca img{height:32px}
    .halo-seccion{padding:0}
    .halo-tarjeta{height:100vh;height:100svh;min-height:520px}
    .halo-contenido{padding:104px 24px 28px}
    .halo p{font-size:16px}
    .halo-pulso{padding-top:36px}
    .halo-pulso .principal b{font-size:38px}
    .halo-pulso .principal span{font-size:15px}
    .halo-aura{background:
      radial-gradient(80% 46% at 42% 34%,rgba(255,255,255,.92),rgba(255,255,255,.55) 48%,rgba(255,255,255,0) 76%),
      radial-gradient(60% 34% at 16% 22%,rgba(255,255,255,.5),rgba(255,255,255,0) 72%)}
    /* el menú se esconde con max-md:hidden en el propio componente */
  }
  @media (prefers-reduced-motion:reduce){
    .halo-fondo img,.halo-aura,.halo-pulso .punto::before{animation:none}
    .halo-fondo img:nth-child(1){opacity:1}
    .halo .cifra{animation:none;--n:var(--meta)}
  }
</style>
