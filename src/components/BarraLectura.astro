---
/**
 * La barra de arriba de las guías y de /blog/: logo, menú, teléfono y
 * «Solicitar cotización». Es la misma cabecera del hero de las páginas de
 * servicio (HeroHalo), pero sobre fondo claro y en el flujo de la página,
 * porque las guías no llevan foto a pantalla completa.
 */
import MenuSvea from './ui/navigation-menu-06';
import { MenuMovil } from './ui/menu-movil';

interface Props { cotizar: string }
const { cotizar } = Astro.props;
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<div class="art-barra">
  <a class="art-marca" href={`${BASE}/`} aria-label="SVEA Consultores, inicio">
    <img src={`${BASE}/img/logo-svea.webp`} width="404" height="137" alt="SVEA Consultores" />
  </a>
  <MenuSvea base={BASE} client:idle />
  <div class="art-barra-acciones">
    <!-- sólo el icono de llamar, sin el número (29-sep) -->
    <a class="art-llamar" href="tel:+56929947924" aria-label="Llamar a SVEA Consultores" title="Llamar a SVEA Consultores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg></a>
    <a class="btn-flecha chica max-md:hidden" href={cotizar} style="gap:0"><span>Solicitar cotización</span></a>
    <MenuMovil base={BASE} client:idle />
  </div>
</div>


<style is:global>
  .art-barra{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:80rem;margin:0 auto;padding:20px 48px}
  .art-barra-acciones{display:flex;align-items:center;gap:14px}
  .art-marca img{height:40px;width:auto;display:block}
  .art-tel{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;font-size:15px;font-weight:500;color:#000;text-decoration:none}
  .art-tel:hover{color:var(--verde)}
  .art-tel svg{width:17px;height:17px;color:rgba(0,0,0,.5)}
  .art-llamar{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;transition:background .2s;color:#000}
  .art-llamar svg{width:21px;height:21px}
  .art-llamar:hover{background:rgba(0,0,0,.06)}

  @media (max-width:820px){
    .art-barra{padding:14px 24px}
    .art-marca img{height:32px}
  }
</style>
