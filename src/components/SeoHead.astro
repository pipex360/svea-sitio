---
/**
 * Cabecera SEO común de las páginas rehechas.
 *
 * Reproduce lo que Rank Math publica en el WordPress (title, descripción,
 * robots, canónica, Open Graph, Twitter y los bloques JSON-LD de
 * src/data/paginas.json) y agrega el FAQPage armado con las mismas
 * preguntas que se ven en la página, para que Google pueda mostrarlas.
 *
 * En la copia de trabajo el robots es siempre «noindex, nofollow»; en
 * producción (SVEA_PRODUCCION=1) es el de la página.
 *
 * En las guías (`articulo`) el JSON-LD lleva UN solo Article —autor y editor
 * la organización SVEA, nunca la Person «admin» de Rank Math— y UN solo
 * BreadcrumbList (Inicio › Guías › título): los Article, BreadcrumbList y
 * Person heredados de paginas.json se descartan. En todas las páginas la
 * Person «admin» se quita y cualquier «author» que la apunte pasa a SVEA.
 *
 * Desde el 24-sep: ningún Article fuera de las guías; los Service sueltos de
 * Rank Math se descartan, el ProfessionalService lleva el OfferCatalog de los
 * 8 servicios y cada página de servicio suma UN Service, el suyo. inLanguage
 * va «es-CL», igual que el <html lang>. Sin canónica (la 404) no hay
 * <link rel=canonical> ni og:url.
 */
interface Pagina {
  title: string;
  description: string;
  robots: string;
  canonical: string;
  og_image?: string;
  jsonld?: unknown[];
}
interface Props {
  pagina: Pagina;
  copia: boolean;
  faq?: { p: string; r: string }[];
  /** og:type: «article» en las guías, «website» en el resto */
  tipo?: 'website' | 'article';
  /** sólo en las guías: arma el Article y el BreadcrumbList únicos */
  articulo?: { titulo: string; miga: string; publicado?: string; modificado?: string; imagen?: string; seccion?: string };
}
const { pagina, copia, faq = [], tipo = 'website', articulo } = Astro.props;
const SITIO = 'https://sveaconsultores.cl';
const ORG = { '@type': 'Organization', '@id': `${SITIO}/#organization`, name: 'SVEA Consultores', url: SITIO };
/** Los 8 servicios: el catálogo del ProfessionalService y el Service de cada página de servicio. */
const SERVICIOS_LD = [
  { ruta: '/calificacion-tecnica-industrial/', name: 'Calificación Técnica Industrial (CTI)', alternateName: 'Certificado de Actividad Inofensiva', description: 'Evaluación de infraestructura y preparación de expedientes técnicos para la SEREMI de Salud, necesarios para la obtención de patente municipal industrial. Incluye inspección técnica, expediente completo, planos, memorias y tramitación ante la autoridad.' },
  { ruta: '/informe-sanitario/', name: 'Informe Sanitario', alternateName: 'Informe Sanitario Favorable SEREMI', description: 'Preparación del expediente y tramitación del informe sanitario (resolución o autorización sanitaria) ante la SEREMI de Salud, con seguimiento hasta la resolución.' },
  { ruta: '/estudio-de-carga-de-combustible/', name: 'Estudio de Carga de Combustible (ECC)', description: 'Evaluación del riesgo de incendio en instalaciones comerciales e industriales según los materiales presentes. Cálculo de carga de combustible por sector, clasificación de riesgo y recomendaciones de mitigación.' },
  { ruta: '/planes-de-emergencia-y-evacuacion/', name: 'Plan de Emergencia y Evacuación Industrial', description: 'Planes personalizados de emergencia y evacuación para empresas e industrias. Protocolos de actuación ante incendio, sismo, derrame y otras emergencias. Incluye planos de evacuación, roles y capacitación.' },
  { ruta: '/planes-de-emergencia-y-evacuacion-condominios/', name: 'Plan de Emergencia y Evacuación para Condominios', description: 'Planes de emergencia a medida para condominios y edificios residenciales. Protocolos claros de evacuación, roles de emergencia y señalética para resguardar la vida de los residentes.' },
  { ruta: '/manejo-de-residuos-peligrosos/', name: 'Manejo de Sustancias y Residuos Peligrosos', description: 'Asesoría integral para el manejo seguro y legal de sustancias peligrosas según D.S. 43 y D.S. 148. Minimización de riesgos operativos y cumplimiento normativo.' },
  { ruta: '/autorizacion-de-transporte-de-residuos/', name: 'Autorización de Transporte de Residuos Peligrosos y No Peligrosos', description: 'Gestión de permisos y autorizaciones para el transporte de residuos peligrosos y no peligrosos. Tramitación completa ante la autoridad sanitaria.' },
  { ruta: '/permisos-ambientales-y-pertinencias-del-seia/', name: 'Permisos Ambientales y Pertinencias del SEIA', description: 'Evaluación de la pertinencia de ingreso al Sistema de Evaluación de Impacto Ambiental (SEIA) y gestión de los permisos ambientales aplicables al proyecto.' },
];
const CATALOGO = {
  '@type': 'OfferCatalog',
  name: 'Servicios de Consultoría Ambiental',
  itemListElement: SERVICIOS_LD.map((x) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', '@id': `${SITIO}${x.ruta}#service`, name: x.name, url: `${SITIO}${x.ruta}` },
  })),
};
const robots = copia ? 'noindex, nofollow' : pagina.robots;
const titulo = pagina.title.replace(/&[a-z]+;/g, (e) => ({ '&amp;': '&', '&oacute;': 'ó', '&eacute;': 'é', '&aacute;': 'á', '&iacute;': 'í', '&uacute;': 'ú', '&ntilde;': 'ñ' } as Record<string, string>)[e] ?? e);
// El FAQPage sale SIEMPRE de las preguntas que se ven en la página: si la
// página las pasa, se descarta cualquier FAQPage heredado de Rank Math en
// paginas.json (traía respuestas y plazos viejos).
const esFaq = (n: any) => n && typeof n === 'object' && n['@type'] === 'FAQPage';
// Los nodos de la página (WebPage, Article, CollectionPage, Blog) llevan el
// title y la description de hoy, no los que Rank Math tenía guardados.
const TIPOS_PAGINA = new Set(['WebPage', 'Article', 'CollectionPage', 'Blog']);
const alDia = (n: any) => {
  if (!n || typeof n !== 'object' || !TIPOS_PAGINA.has(n['@type'])) return n;
  const m = { ...n };
  if ('name' in m) m.name = titulo;
  if ('headline' in m) m.headline = titulo;
  if ('description' in m) m.description = pagina.description;
  return m;
};
// la Person «admin» de Rank Math no es un autor: fuera, y quien la apunte pasa a SVEA
const esAdmin = (n: any) => n && typeof n === 'object' && n['@type'] === 'Person' && /\/author\/admin\/?$/.test(n['@id'] ?? '');
const sinAdmin = (n: any) => {
  if (!n || typeof n !== 'object') return n;
  const a = n.author;
  if (a && typeof a === 'object' && (a.name === 'admin' || /\/author\/admin\//.test(a['@id'] ?? ''))) return { ...n, author: ORG };
  return n;
};
// en las guías, el Article y las migas los arma esta cabecera (uno de cada uno)
const TIPOS_GUIA = new Set(['Article', 'BreadcrumbList']);
// en /blog/ el Article heredado del WordPress («6 Guías…») sobra: la página es un Blog
// Desde el 24-sep: ningún Article fuera de las guías (Rank Math ponía uno en
// la portada, los servicios, /gracias/ y la política), y fuera también los
// seis Service sueltos que Rank Math repetía en todas las páginas: cada
// página de servicio lleva SU Service (abajo) y el catálogo va dentro del
// ProfessionalService.
const fuera = (n: any) =>
  !n || typeof n !== 'object' ? false
  : esAdmin(n) || (faq.length > 0 && esFaq(n))
    || n['@type'] === 'Article' || n['@type'] === 'Service'
    || (articulo ? TIPOS_GUIA.has(n['@type']) : false);
let migasVistas = 0;
const bloques = (pagina.jsonld ?? [])
  .filter((b: any) => !fuera(b))
  // un solo BreadcrumbList también fuera de las guías (el WordPress repetía el suyo)
  .filter((b: any) => !(b && b['@type'] === 'BreadcrumbList' && migasVistas++ > 0))
  .map((b: any) =>
    b && Array.isArray(b['@graph'])
      ? { ...b, '@graph': b['@graph'].filter((n: any) => !fuera(n)).map(alDia).map(sinAdmin) }
      : sinAdmin(alDia(b)),
  )
  // el ProfessionalService de la empresa, con el catálogo de los 8 servicios
  .map((b: any) => (b && b['@type'] === 'ProfessionalService' ? { ...b, hasOfferCatalog: CATALOGO } : b));
// en una página de servicio, UN Service: el suyo
const servicioLD = (() => {
  const sv = SERVICIOS_LD.find((x) => `${SITIO}${x.ruta}` === pagina.canonical);
  if (!sv) return null;
  const { ruta, ...resto } = sv;
  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITIO}${ruta}#service`,
    ...resto,
    url: `${SITIO}${ruta}`,
    provider: { '@id': `${SITIO}/#organization` },
    serviceType: 'Consultoría Ambiental',
    areaServed: { '@type': 'Country', name: 'Chile' },
  };
})();
const url = pagina.canonical;
const articuloLD = articulo
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: articulo.titulo,
      description: pagina.description,
      ...(articulo.imagen ? { image: articulo.imagen } : {}),
      inLanguage: 'es-CL',
      ...(articulo.seccion ? { articleSection: articulo.seccion } : {}),
      author: ORG,
      publisher: { ...ORG, logo: { '@type': 'ImageObject', url: `${SITIO}/img/logo-svea.png` } },
      ...(articulo.publicado ? { datePublished: articulo.publicado } : {}),
      ...(articulo.modificado ? { dateModified: articulo.modificado } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    }
  : null;
const migasLD = articulo
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITIO}/` },
        { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITIO}/blog/` },
        { '@type': 'ListItem', position: 3, name: articulo.miga, item: url },
      ],
    }
  : null;
const faqPage = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map(({ p, r }) => ({
        '@type': 'Question',
        name: p,
        acceptedAnswer: { '@type': 'Answer', text: r },
      })),
    }
  : null;
---
<title set:html={pagina.title}></title>
<link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="48x48" />
<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icon-192.png`} sizes="192x192" />
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
<meta name="description" content={pagina.description} />
<meta name="robots" content={robots} />
{pagina.canonical && <link rel="canonical" href={pagina.canonical} />}
<meta property="og:locale" content="es_CL" />
<meta property="og:type" content={tipo} />
<meta property="og:site_name" content="SVEA Consultores" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={pagina.description} />
{pagina.canonical && <meta property="og:url" content={pagina.canonical} />}
{pagina.og_image && <meta property="og:image" content={pagina.og_image} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={pagina.description} />
{pagina.og_image && <meta name="twitter:image" content={pagina.og_image} />}
{bloques.map((bloque) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(bloque).replace(/"inLanguage":"es"/g, '"inLanguage":"es-CL"')} />
))}
{servicioLD && <script type="application/ld+json" is:inline set:html={JSON.stringify(servicioLD)} />}
{articuloLD && <script type="application/ld+json" is:inline set:html={JSON.stringify(articuloLD)} />}
{migasLD && <script type="application/ld+json" is:inline set:html={JSON.stringify(migasLD)} />}
{faqPage && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />}
